      - data:
          code: |-
            import ipaddress
            import json
            import re

            SECRET_RE = re.compile(r"(?i)(?:-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|github_pat_[A-Za-z0-9_]{30,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|(?:api[_-]?key|secret|token)\s*[:=]\s*['\"]?[A-Za-z0-9_./+=-]{24,})")
            HOST_RE = re.compile(r"(?i)\b(?:[A-Z0-9](?:[A-Z0-9-]{0,61}[A-Z0-9])?\.)+[A-Z]{2,63}\b")
            FILE_EXTENSIONS = {"md", "py", "ts", "tsx", "js", "jsx", "json", "yaml", "yml", "toml", "txt", "html", "css"}
            IPV4_RE = re.compile(r"(?<![0-9])(?:[0-9]{1,3}\.){3}[0-9]{1,3}(?![0-9])")
            IPV6_RE = re.compile(r"(?<![A-Fa-f0-9:])[A-Fa-f0-9:]{2,}(?![A-Fa-f0-9:])")

            def has_private_address(text):
                for candidate in IPV4_RE.findall(text):
                    try:
                        ipaddress.ip_address(candidate)
                        return True
                    except ValueError:
                        pass
                for candidate in IPV6_RE.findall(text):
                    if ":" not in candidate:
                        continue
                    try:
                        ipaddress.ip_address(candidate)
                        return True
                    except ValueError:
                        pass
                for candidate in HOST_RE.findall(text):
                    if candidate.rsplit(".", 1)[-1].lower() not in FILE_EXTENSIONS:
                        return True
                return False

            __DIFY_HELPER_JSON_FENCE__
            def main(model_text: str, page_paths_json: str) -> dict:
                if not isinstance(model_text, str) or not model_text.strip():
                    return {"proposal_json": ""}
                try:
                    result = json.loads(strip_json_fence(model_text))
                    page_paths = set(json.loads(page_paths_json))
                except (TypeError, ValueError):
                    return {"proposal_json": ""}
                edits = result.get("page_edits") if isinstance(result, dict) else None
                if not isinstance(edits, list):
                    return {"proposal_json": ""}
                safe_edits, seen = [], set()
                for edit in edits:
                    if not isinstance(edit, dict) or set(edit) != {"page_path", "reason", "proposed_text"}:
                        return {"proposal_json": ""}
                    path, reason, text = edit["page_path"], edit["reason"], edit["proposed_text"]
                    if (not isinstance(path, str) or path not in page_paths or path in seen
                        or "://" in path or ".." in path.split("/")
                        or not isinstance(reason, str) or not reason.strip()
                        or not isinstance(text, str) or not text.strip()):
                        return {"proposal_json": ""}
                    if (SECRET_RE.search(path + "\n" + reason + "\n" + text)
                        or has_private_address(path + "\n" + reason + "\n" + text)):
                        return {"proposal_json": ""}
                    seen.add(path)
                    safe_edits.append({"page_path": path, "reason": reason, "proposed_text": text})
                if not safe_edits:
                    return {"proposal_json": ""}
                return {"proposal_json": json.dumps({"page_edits": safe_edits}, ensure_ascii=False)}
          code_language: python3
          desc: Accepts only valid page edits whose paths were supplied and whose text omits likely secrets and private addresses.
          outputs:
            proposal_json: {type: string, children: null}
          selected: false
          title: Validate safe page proposals
          type: code
          variables:
            - {variable: model_text, value_selector: [docs_updater_llm, text]}
            - {variable: page_paths_json, value_selector: [prepare_context, page_paths_json]}

      - data:
          code: |-
            import re

            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            FINDING_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,128}$")
            DECISIONS = ("A", "B", "neither")

            def main(event: str, action: str, merged: str, org: str, repo: str, pr_number: int, finding_ref: str, operator_decision: str) -> dict:
                repo_allowed = isinstance(repo, str) and REPO_RE.fullmatch(repo) is not None
                if isinstance(operator_decision, str) and operator_decision:
                    valid = (
                        repo_allowed
                        and operator_decision in DECISIONS
                        and isinstance(finding_ref, str)
                        and FINDING_RE.fullmatch(finding_ref) is not None
                    )
                    return {
                        "accepted": 1 if valid else 0,
                        "eligible": 0,
                        "decision": operator_decision if valid else "",
                        "finding_ref": finding_ref if valid else "",
                    }
                valid = (
                    event == "pull_request"
                    and action == "closed"
                    and str(merged).lower() == "true"
                    and isinstance(org, str)
                    and org.lower() == "dryvist"
                    and repo_allowed
                    and isinstance(pr_number, int)
                    and not isinstance(pr_number, bool)
                    and pr_number > 0
                )
                return {"accepted": 1 if valid else 0, "eligible": 1 if valid else 0, "decision": "", "finding_ref": ""}
          code_language: python3
          desc: Accepts merged pull_request closed events from dryvist repositories, or one operator decision on a reported finding. Only the pull request path continues to the pull request reads.

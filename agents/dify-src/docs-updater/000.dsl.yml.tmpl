app:
  description: Read-only documentation proposals for merged pull requests.
  icon: "\U0001F916"
  icon_background: "#D5F5F6"
  mode: workflow
  name: __DIFY_AGENT_NAME__
  use_icon_as_answer_icon: false
dependencies: []
kind: app
version: 0.7.0
workflow:
  conversation_variables: []
  environment_variables:
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50201
      name: OPENBAO_ADDR
      value: ''
      value_type: string
      description: OpenBao base URL supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50202
      name: OPENBAO_ROLE_ID
      value: ''
      value_type: secret
      description: OpenBao AppRole role ID supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50203
      name: OPENBAO_SECRET_ID
      value: ''
      value_type: secret
      description: OpenBao AppRole secret ID supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50204
      name: GITHUB_API_BASE
      value: ''
      value_type: string
      description: GitHub API base URL supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50205
      name: GITHUB_TOKEN_MINT_PATH
      value: ''
      value_type: string
      description: Approved installation-token mint path supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50208
      name: GITHUB_TOKEN_READ_SET
      value: ''
      value_type: string
      description: Read-only token set for github-token/docs-updater.
      selector: []
  features:
    file_upload:
      enabled: false
    opening_statement: ''
    retriever_resource:
      enabled: false
    sensitive_word_avoidance:
      enabled: false
    speech_to_text:
      enabled: false
    suggested_questions: []
    suggested_questions_after_answer:
      enabled: false
    text_to_speech:
      enabled: false
  graph:
    edges:
      - data: {isInIteration: false, isInLoop: false, sourceType: start, targetType: code}
        id: start-validate-event
        source: start
        sourceHandle: source
        target: validate_event
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: event-validated
        source: validate_event
        sourceHandle: source
        target: event_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: http-request}
        id: event-ready
        source: event_gate
        sourceHandle: eligible
        target: openbao_login
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: if-else}
        id: event-not-eligible
        source: event_gate
        sourceHandle: 'false'
        target: decision_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: code}
        id: decision-accepted
        source: decision_gate
        sourceHandle: accepted
        target: prepare_context
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: end}
        id: decision-rejected
        source: decision_gate
        sourceHandle: 'false'
        target: end_empty
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: http-request, targetType: code}
        id: login-parsed
        source: openbao_login
        sourceHandle: source
        target: parse_openbao
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: login-ready-check
        source: parse_openbao
        sourceHandle: source
        target: login_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: code}
        id: login-ready
        source: login_gate
        sourceHandle: ready
        target: token_request
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: end}
        id: login-failed
        source: login_gate
        sourceHandle: 'false'
        target: end_empty
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: token-set-checked
        source: token_request
        sourceHandle: source
        target: token_request_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: http-request}
        id: token-set-ready
        source: token_request_gate
        sourceHandle: eligible
        target: mint_github_token
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: end}
        id: token-set-missing
        source: token_request_gate
        sourceHandle: 'false'
        target: end_empty
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: http-request, targetType: code}
        id: token-minted
        source: mint_github_token
        sourceHandle: source
        target: parse_github_token
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: token-ready-check
        source: parse_github_token
        sourceHandle: source
        target: token_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: http-request}
        id: token-ready
        source: token_gate
        sourceHandle: ready
        target: get_repo
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: end}
        id: token-failed
        source: token_gate
        sourceHandle: 'false'
        target: end_empty
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: http-request, targetType: http-request}
        id: repo-read
        source: get_repo
        sourceHandle: source
        target: get_pull_request
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: http-request, targetType: http-request}
        id: pr-read
        source: get_pull_request
        sourceHandle: source
        target: get_pull_files
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: http-request, targetType: code}
        id: files-read
        source: get_pull_files
        sourceHandle: source
        target: prepare_context
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: context-prepared
        source: prepare_context
        sourceHandle: source
        target: context_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: llm}
        id: context-safe
        source: context_gate
        sourceHandle: eligible
        target: docs_updater_llm
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: end}
        id: context-empty
        source: context_gate
        sourceHandle: 'false'
        target: end_empty
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: llm, targetType: code}
        id: proposal-generated
        source: docs_updater_llm
        sourceHandle: source
        target: validate_proposal
        targetHandle: target
        type: custom
        zIndex: 0
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: end}
        id: proposal-validated
        source: validate_proposal
        sourceHandle: source
        target: end_proposal
        targetHandle: target
        type: custom
        zIndex: 0
    nodes:
      - data:
          desc: Immutable event and mandate fields plus the available private documentation page context.
          variables:
            - {variable: event, label: event, type: text-input, required: false, max_length: 64, options: [], default: '', hint: 'Required for the pull request shape; the gate checks it.', placeholder: ''}
            - {variable: action, label: action, type: text-input, required: false, max_length: 64, options: [], default: '', hint: 'Required for the pull request shape; the gate checks it.', placeholder: ''}

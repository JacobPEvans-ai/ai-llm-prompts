app: {description: 'Check one draft against the style rules and return findings.', mode: workflow, name: __DIFY_AGENT_NAME__}
dependencies: []
kind: app
version: 0.7.0
workflow:
  environment_variables: []
  graph:
    edges:
      - {data: {sourceType: start, targetType: llm}, id: e1, source: start, sourceHandle: source, target: model, targetHandle: target, type: custom}
      - {data: {sourceType: llm, targetType: code}, id: e2, source: model, sourceHandle: source, target: validate, targetHandle: target, type: custom}
      - {data: {sourceType: code, targetType: end}, id: e3, source: validate, sourceHandle: source, target: done, targetHandle: target, type: custom}
    nodes:
      - data:
          title: Start
          type: start
          variables:
            - {variable: text, label: text, type: paragraph, required: true, max_length: 30000, options: [], hint: 'Markdown draft, or a JSON object whose string values are checked'}
        id: start
        position: {x: 40, y: 300}
        type: custom
      - data:
          model: {completion_params: {temperature: 0}, mode: chat, name: __DIFY_LITELLM_ROLE__, provider: langgenius/openai_api_compatible/openai_api_compatible}
          prompt_template:
            - id: system-prompt
              role: system
              text: |-
                __DIFY_SYSTEM_PROMPT__
            - {id: user-prompt, role: user, text: 'Untrusted input: {{#start.text#}}'}
          prompt_config: {jinja2_variables: []}
          title: Check draft
          type: llm
        id: model
        position: {x: 340, y: 300}
        type: custom
      - data:
          # Callers receive only an envelope that matches output_schema; anything else becomes status stop.
          code: |-
            import json
            __DIFY_HELPER_JSON_FENCE__
            __DIFY_HELPER_ENVELOPE__
            SCHEMA = json.loads(__DIFY_OUTPUT_SCHEMA__)
            def result_problem(result, text):
                if result["pass"] != (not result["findings"]):
                    return "reply.result.pass must be true only when findings is empty"
                return None
            def main(reply: str, text: str) -> dict:
                if not str(text).strip():
                    envelope = {"status": "stop", "reason": "input is empty", "result": None}
                else:
                    parsed, problem = check_envelope(reply, SCHEMA)
                    if problem is None and parsed["status"] == "ok":
                        problem = result_problem(parsed["result"], text)
                    envelope = parsed if problem is None else {"status": "stop", "reason": problem, "result": None}
                return {"status": envelope["status"], "envelope": json.dumps(envelope, ensure_ascii=False)}
          code_language: python3
          outputs: {status: {type: string}, envelope: {type: string}}
          title: Validate reply
          type: code
          variables:
            - {variable: reply, value_selector: [model, text]}
            - {variable: text, value_selector: [start, text]}
        id: validate
        position: {x: 640, y: 300}
        type: custom
      - data:
          outputs:
            - {variable: status, value_selector: [validate, status]}
            - {variable: envelope, value_selector: [validate, envelope]}
          title: End
          type: end
        id: done
        position: {x: 940, y: 300}
        type: custom

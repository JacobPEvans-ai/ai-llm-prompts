            import json,re,urllib.request
            from urllib.parse import urlsplit
            def link_state(url,web_host,api_base,addr,role,secret,path,session):
                try:
                    p=urlsplit(url); m=re.fullmatch(r'/([^/]+)/([^/]+)/(pull|issues)/([1-9][0-9]*)/?',p.path)
                    if p.scheme!='https' or p.netloc!=web_host or not m:return None
                    if not session:
                        req=urllib.request.Request(addr.rstrip('/')+'/v1/auth/approle/login',data=json.dumps({'role_id':role,'secret_id':secret}).encode(),headers={'Content-Type':'application/json'},method='POST')
                        with urllib.request.urlopen(req,timeout=10) as r: login=json.loads(r.read())
                        client=login.get('auth',{}).get('client_token','')
                        req=urllib.request.Request(addr.rstrip('/')+'/v1/'+path.strip('/'),headers={'X-Vault-Token':client})
                        with urllib.request.urlopen(req,timeout=10) as r: payload=json.loads(r.read())
                        data=payload.get('data',{}); session.append(data.get('token') or data.get('data',{}).get('token'))
                    token=session[0]
                    if not token:return None
                    owner,repo,kind,num=m.groups(); endpoint='pulls' if kind=='pull' else 'issues'
                    req=urllib.request.Request(api_base.rstrip('/')+f'/repos/{owner}/{repo}/{endpoint}/{num}',headers={'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json'})
                    with urllib.request.urlopen(req,timeout=10) as r: obj=json.loads(r.read())
                    state='merged' if obj.get('merged') is True else str(obj.get('state','')).lower()
                    return state if state in ('merged','closed','open') else None
                except Exception:return None
            def main(results:list, timestamp:str, web_host:str, api_base:str, bao_addr:str, role_id:str, secret_id:str, token_path:str)->dict:
                refs=[]; visible=[]
                session=[]
                for entry in results or []:
                    try:
                        group=json.loads(entry) if isinstance(entry,str) else entry
                        project=str(group.get('project_id',''))
                        for task in group.get('tasks',[]):
                            if not isinstance(task,dict): continue
                            task_id=task.get('id',task.get('taskId'))
                            if task_id is None or not project: continue
                            i=len(refs); title=str(task.get('title','')); desc=str(task.get('description',''))
                            refs.append({'task_index':i,'id':str(task_id),'project_id':project,'title':title,'description':desc,'created':task.get('created',''),'due_date':task.get('dueDate',task.get('due_date','')),'priority':task.get('priority'),'done':task.get('done',False),'labels':task.get('labels',[])})
                            links=re.findall(r'https://[^\s<>"\']+',title+' '+desc)
                            url=''; state=None
                            for candidate in links:
                                candidate=candidate.rstrip('.,);]'); found=link_state(candidate,web_host,api_base,bao_addr,role_id,secret_id,token_path,session)
                                if not url:url=candidate
                                if found:url,state=candidate,found; break
                            visible.append({'task_index':i,'title':title,'description':desc,'created':task.get('created',''),'due_date':task.get('dueDate',task.get('due_date','')),'priority':task.get('priority'),'done':task.get('done',False),'labels':task.get('labels',[]),'linked_work':{'url':url,'state':state or 'unverified'} if url else None})
                    except Exception: continue
                return {'task_refs':json.dumps(refs),'model_tasks':json.dumps({'timestamp':timestamp,'tasks':visible},ensure_ascii=False)}

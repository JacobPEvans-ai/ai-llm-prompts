            def main(model_text:str,refs_text:str,allowed_raw:str,readonly_raw:str,rank_raw:str,denied_raw:str,mode_raw:str,web_host:str,api_base:str,bao_addr:str,role_id:str,secret_id:str,token_path:str)->dict:
                actions=[]; seen=set(); mode=str(mode_raw or '').strip().lower()
                try:
                    allowed,readonly,rank_only,denied=map(projects,(allowed_raw,readonly_raw,rank_raw,denied_raw))
                    refs=json.loads(refs_text)
                    if rank_only-allowed or mode not in ('shadow','live'): raise ValueError()
                except Exception: return {'actions':[],'actions_json':'[]','dispatch':False,'mode':'invalid'}
                try:
                    intent=json.loads(strip_json_fence(model_text)); proposed=intent.get('actions',[]) if isinstance(intent,dict) else []
                except Exception: proposed=[]
                cache={}
                allowed_operations=__DIFY_TOOL_OPERATIONS__
                def add(ref,op,**fields):
                    if op not in allowed_operations: raise ValueError('Operation is not declared by this agent.')
                    key=(ref['id'],op,json.dumps(fields,sort_keys=True,ensure_ascii=False))
                    if key in seen:return
                    seen.add(key); actions.append({'operation':op,'id':ref['id'],'projectId':ref['project_id'],**fields})
                for ref in refs:
                    project=ref['project_id']
                    if project in denied or project not in allowed|readonly: continue
                    text=(str(ref.get('title',''))+' '+str(ref.get('description','')))
                    if has_incident_marker(ref.get('title'),ref.get('description'),ref.get('category'),ref.get('categories')):
                        if project in allowed and project not in rank_only: add(ref,'__DIFY_TOOL_OPERATION_COMMENT__',comment='This item belongs in Zammad.')
                        continue
                    for item in proposed if isinstance(proposed,list) else []:
                        if not isinstance(item,dict) or type(item.get('task_index')) is not int or item['task_index']!=ref['task_index']: continue
                        kind=item.get('kind')
                        if kind=='rank' and project in allowed:
                            fields={}
                            p=item.get('priority',ref.get('priority'))
                            if isinstance(p,(int,float)) and not isinstance(p,bool): fields['priority']=p
                            labels=item.get('labels',ref.get('labels',[]))
                            if isinstance(labels,list) and all(isinstance(x,str) for x in labels): fields['labels']=labels
                            if fields: add(ref,'__DIFY_TOOL_OPERATION_UPDATE__',**fields)
                        elif kind in ('comment','done') and project in allowed and project not in rank_only:
                            urls=re.findall(r'https://[^\s<>"\']+',text)
                            for raw_url in urls:
                                url=raw_url.rstrip('.,);]')
                                state=state_for(url,web_host,api_base,bao_addr,role_id,secret_id,token_path,cache)
                                if state is None: continue
                                if kind=='comment':
                                    add(ref,'__DIFY_TOOL_OPERATION_COMMENT__',comment=f'Linked GitHub work: {url} (state: {state}).')
                                    break
                                if kind=='done' and state in ('merged','closed') and not ref.get('done'):
                                    add(ref,'__DIFY_TOOL_OPERATION_UPDATE__',done=True); break
                return {'actions':actions,'actions_json':json.dumps(actions,ensure_ascii=False),'dispatch':mode=='live','mode':mode}

                parsed = json.loads(raw)
                if not isinstance(parsed, list):
                    raise ValueError("project policy must be a JSON array")
                values = {str(item).strip() for item in parsed}
                if "" in values:
                    raise ValueError("project policy is invalid")
                return values

            def output(allowed=False, reason="", **values):
                result = {
                    "allowed": allowed,
                    "reason": reason,
                    "dispatch": False,
                    "preview": "",
                    "needs_update_check": False,
                    "operation": "",
                    "task_id": "",
                    "project_id": "",
                    "requested_project_id": "",
                    "title": "",
                    "description": "",
                    "due_date": "",
                    "priority": None,
                    "done": None,
                    "filter": "",
                    "search": "",
                }
                result.update(values)
                return result

            def preview_call(operation, **args):
                args = {key: value for key, value in args.items() if value is not None and value != ""}
                return json.dumps({"tool": "__DIFY_TOOL_NAME__", "args": {"subcommand": operation, **args}}, separators=(",", ":"))


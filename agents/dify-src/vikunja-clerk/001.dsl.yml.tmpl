            def main(intent_text: str, project_id_mandate: str, task_id_mandate: str, allowed_projects_raw: str, denied_projects_raw: str, inbox_project_id: str, mode_raw: str) -> dict:
                try:
                    intent = json.loads(strip_json_fence(intent_text))
                    if not isinstance(intent, dict) or intent.get("route") != "vikunja":
                        return output(reason="Refused; file this in Zammad.")
                    title = "" if intent.get("title") is None else str(intent["title"])
                    description = "" if intent.get("description") is None else str(intent["description"])
                    if has_incident_marker(title, description, intent.get("category"), intent.get("categories")):
                        return output(reason="Refused; file this in Zammad.")
                    operation = intent.get("operation")
                    if operation not in __DIFY_TOOL_OPERATIONS__:
                        return output(reason="The operation is missing or unsupported.")
                    mode = str(mode_raw or "").strip().lower()
                    if operation in {"create", "update"} and mode not in {"shadow", "live"}:
                        return output(reason="Write mode is missing or invalid; writes are refused.")
                    project_id_mandate = str(project_id_mandate or "").strip()
                    task_id_mandate = str(task_id_mandate or "").strip()
                    due_date = "" if intent.get("due_date") is None else str(intent["due_date"])
                    priority = intent.get("priority")
                    done = intent.get("done")
                    if priority is not None and (isinstance(priority, bool) or not isinstance(priority, (int, float))):
                        return output(reason="Priority must be a number.")
                    if done is not None and type(done) is not bool:
                        return output(reason="Done must be a boolean.")
                    filter_value = "" if intent.get("filter") is None else str(intent["filter"])
                    search = "" if intent.get("search") is None else str(intent["search"])
                    if operation == "list":
                        return output(True, operation="list", dispatch=True, done=done, filter=filter_value, search=search)
                    if operation == "get":
                        task_id = "" if intent.get("task_id") is None else str(intent["task_id"]).strip()
                        if not task_id:
                            return output(reason="A task reference is required for get.")
                        return output(True, operation="get", dispatch=True, task_id=task_id)
                    project_named = intent.get("project_named")
                    if not project_id_mandate and type(project_named) is not bool:
                        return output(reason="Project scope is missing or ambiguous.")
                    try:
                        allowed = project_set(allowed_projects_raw)
                        denied = project_set(denied_projects_raw)
                    except (TypeError, ValueError, json.JSONDecodeError):
                        return output(reason="Project policies are missing or invalid; writes are refused.")
                    if operation == "create":
                        if not title.strip():
                            return output(reason="A task title is required for create.")
                        if project_id_mandate:
                            project_id = project_id_mandate
                        elif project_named:
                            return output(reason="The named project is unknown or unscoped.")
                        else:
                            project_id = str(inbox_project_id or "").strip()
                            if not project_id:
                                return output(reason="The inbox project policy is missing; the create is refused.")
                        if project_id in denied:
                            return output(reason="The target project is denied; deny wins over allow.")
                        if project_id not in allowed:
                            return output(reason="The target project is unknown or outside the allowed policy.")
                        preview = preview_call("create", projectId=project_id, title=title, description=description, dueDate=due_date, priority=priority, done=done)
                        return output(True, operation="create", dispatch=mode == "live", preview=preview, project_id=project_id, title=title, description=description, due_date=due_date, priority=priority, done=done)
                    task_id = task_id_mandate
                    if not task_id:
                        return output(reason="A task reference is required for update.")
                    requested_project_id = project_id_mandate
                    if project_named and not requested_project_id:
                        return output(reason="The named project is unknown or unscoped.")
                    if requested_project_id:
                        if requested_project_id in denied:
                            return output(reason="The requested project is denied; deny wins over allow.")
                        if requested_project_id not in allowed:
                            return output(reason="The requested project is unknown or outside the allowed policy.")
                    if not any([title, description, due_date, priority is not None, done is not None]):
                        return output(reason="At least one task field is required for update.")
                    return output(True, operation="get", dispatch=True, needs_update_check=True, task_id=task_id, requested_project_id=requested_project_id, title=title, description=description, due_date=due_date, priority=priority, done=done)
                except (TypeError, ValueError, json.JSONDecodeError):
                    return output(reason="The request could not be parsed safely; file this in Zammad.")

app:
  description: Read, file, and update Vikunja tasks through a guarded workflow.
  icon: 🤖
  icon_background: '#D5F5F6'
  mode: advanced-chat
  name: __DIFY_AGENT_NAME__
  use_icon_as_answer_icon: false
dependencies: []
kind: app
version: 0.1.5
workflow:
  conversation_variables: []
  environment_variables:
    - id: vikunja_allowed_projects
      name: VIKUNJA_ALLOWED_PROJECTS
      value_type: secret
      value: ''
      description: JSON array resolved from policy://vikunja-clerk/allowed-projects
    - id: vikunja_denied_projects
      name: VIKUNJA_DENIED_PROJECTS
      value_type: secret
      value: ''
      description: JSON array resolved from policy://vikunja-clerk/denied-projects
    - id: vikunja_inbox_project
      name: VIKUNJA_INBOX_PROJECT_ID
      value_type: secret
      value: ''
      description: Runtime project ID resolved from policy://vikunja-clerk/inbox
    - id: vikunja_mode
      name: VIKUNJA_MODE
      value_type: string
      value: __DIFY_MODE__
      description: Use shadow to preview writes; use live only when live writes are authorized.
  features:
    file_upload:
      allowed_file_extensions: []
      allowed_file_types: []
      allowed_file_upload_methods: []
      enabled: false
      image:
        enabled: false
        number_limits: 3
        transfer_methods: [local_file, remote_url]
      number_limits: 3
    opening_statement: ''
    retriever_resource: {enabled: false}
    sensitive_word_avoidance: {enabled: false}
    speech_to_text: {enabled: false}
    suggested_questions: []
    suggested_questions_after_answer: {enabled: false}
    text_to_speech:
      enabled: false
      language: ''
      voice: ''
  graph:
    edges:
      - data: {isInIteration: false, isInLoop: false, sourceType: start, targetType: llm}
        id: start-to-intent
        source: start
        sourceHandle: source
        target: intent
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: llm, targetType: code}
        id: intent-to-guard
        source: intent
        sourceHandle: source
        target: guard
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: guard-to-gate
        source: guard
        sourceHandle: source
        target: guard-gate
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: if-else}
        id: guard-allowed-to-mode-gate
        source: guard-gate
        sourceHandle: guard-allowed
        target: guard-mode-gate
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: answer}
        id: guard-refused-to-answer
        source: guard-gate
        sourceHandle: 'false'
        target: guard-refusal
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: tool}
        id: live-mode-to-preflight
        source: guard-mode-gate
        sourceHandle: live-mode
        target: preflight-tool
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: answer}
        id: shadow-mode-to-preview
        source: guard-mode-gate
        sourceHandle: 'false'
        target: shadow-answer
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: tool, targetType: if-else}
        id: preflight-to-update-route
        source: preflight-tool
        sourceHandle: source
        target: update-route
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: code}
        id: update-route-to-guard
        source: update-route
        sourceHandle: update-check-required
        target: update-guard
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: answer}
        id: read-or-create-to-answer
        source: update-route
        sourceHandle: 'false'
        target: preflight-answer
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: code, targetType: if-else}
        id: update-guard-to-gate
        source: update-guard
        sourceHandle: source
        target: update-gate
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: if-else}
        id: update-allowed-to-mode-gate
        source: update-gate
        sourceHandle: update-allowed
        target: update-mode-gate
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: answer}
        id: update-refused-to-answer
        source: update-gate
        sourceHandle: 'false'
        target: update-refusal
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: tool}
        id: live-update-to-tool
        source: update-mode-gate
        sourceHandle: live-mode
        target: update-tool
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: if-else, targetType: answer}
        id: shadow-update-to-preview
        source: update-mode-gate
        sourceHandle: 'false'
        target: shadow-answer
        targetHandle: target
        type: custom
      - data: {isInIteration: false, isInLoop: false, sourceType: tool, targetType: answer}
        id: update-tool-to-answer
        source: update-tool
        sourceHandle: source
        target: update-answer
        targetHandle: target
        type: custom
    nodes:
      - data:
          desc: Structured project and task scope supplied by the caller.
          selected: false
          title: Start
          type: start
          variables:
            - variable: project_id
              label: project_id
              type: text-input
              required: false
              max_length: 128
              options: []
              default: ''
              hint: Immutable caller-supplied project scope for writes.
              placeholder: ''
            - variable: task_id
              label: task_id
              type: text-input
              required: false
              max_length: 128
              options: []
              default: ''
              hint: Immutable caller-supplied task scope for updates.
              placeholder: ''
        height: 54
        id: start
        position: {x: 40, y: 280}
        positionAbsolute: {x: 40, y: 280}
        selected: false
        sourcePosition: right
        targetPosition: left
        type: custom
        width: 244
      - data:
          context: {enabled: false, variable_selector: []}
          desc: Convert the caller request to structured intent only. This node has no tools.
          memory:
            query_prompt_template: "{{#sys.query#}}"
            role_prefix: {assistant: '', user: ''}
            window: {enabled: false, size: 50}
          model:
            completion_params: {temperature: 0}
            mode: chat
            name: __DIFY_LITELLM_ROLE__
            provider: langgenius/openai_api_compatible/openai_api_compatible
          prompt_template:
            - id: system-prompt
              role: system
              text: |-
                __DIFY_SYSTEM_PROMPT__
            - id: user-prompt
              role: user
              text: '{{#sys.query#}}'
          prompt_config: {jinja2_variables: []}
          selected: false
          title: Parse request
          type: llm
          vision: {enabled: false}
        height: 220
        id: intent
        position: {x: 340, y: 280}
        positionAbsolute: {x: 340, y: 280}
        selected: false
        sourcePosition: right
        targetPosition: left
        type: custom
        width: 244
      - data:
          code: |-
            import json
            import re

            incident_markers = re.compile(r"\b(?:incidents?|outages?|down|breaches?|vulnerabilit(?:y|ies)|cve|exploits?|leaks?|credentials?|secrets?|security|weakness(?:es)?|compromised|compromise|compromising)\b", re.IGNORECASE)

            def marker_text(value):
                if isinstance(value, dict):
                    return " ".join(str(item) for item in value.values())
                if isinstance(value, (list, tuple)):
                    return " ".join(str(item) for item in value)
                return "" if value is None else str(value)

            def has_incident_marker(*values):
                return any(incident_markers.search(marker_text(value)) for value in values)


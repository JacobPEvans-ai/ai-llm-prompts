      - data:
          code: |-
            import json

            def project_set(raw):
                parsed = json.loads(raw)
                if not isinstance(parsed, list):
                    raise ValueError("project policy must be a JSON array")
                values = {str(item).strip() for item in parsed}
                if "" in values:
                    raise ValueError("project policy is invalid")
                return values

            def output(allowed=False, reason="", **values):
                result = {"allowed": allowed, "reason": reason, "dispatch": False, "preview": "", "task_id": "", "project_id": "", "title": "", "description": "", "due_date": "", "priority": None, "done": None}
                result.update(values)
                return result

            def preview_call(**args):
                args = {key: value for key, value in args.items() if value is not None and value != ""}
                return json.dumps({"tool": "__DIFY_TOOL_NAME__", "args": {"operation": "__DIFY_TOOL_OPERATION_UPDATE__", **args}}, separators=(",", ":"))

            def main(intent_text: str, task_result: str, project_id_mandate: str, task_id_mandate: str, allowed_projects_raw: str, denied_projects_raw: str, mode_raw: str) -> dict:
                try:
                    intent = json.loads(intent_text)
                    mode = str(mode_raw or "").strip().lower()
                    if mode not in {"shadow", "live"}:
                        return output(reason="Write mode is missing or invalid; update refused.")
                    project_id_mandate = str(project_id_mandate or "").strip()
                    task_id = str(task_id_mandate or "").strip()
                    project_named = intent.get("project_named")
                    if not project_id_mandate and type(project_named) is not bool:
                        return output(reason="Project scope is missing or ambiguous; update refused.")
                    allowed = project_set(allowed_projects_raw)
                    denied = project_set(denied_projects_raw)
                    result = json.loads(task_result)
                    if isinstance(result, list):
                        result = result[0] if result else {}
                    if isinstance(result, dict) and isinstance(result.get("task"), dict):
                        result = result["task"]
                    if not isinstance(result, dict):
                        return output(reason="The current task could not be read safely; update refused.")
                    current_task_id = str(result.get("id", result.get("taskId", ""))).strip()
                    current_project_id = str(result.get("projectId", result.get("project_id", ""))).strip()
                    if not task_id or task_id != current_task_id or not current_project_id:
                        return output(reason="The current task scope could not be verified; update refused.")
                    if current_project_id in denied:
                        return output(reason="The current task project is denied; deny wins over allow.")
                    if current_project_id not in allowed:
                        return output(reason="The current task project is unknown or outside the allowed policy.")
                    requested_project_id = project_id_mandate
                    if project_named and not requested_project_id:
                        return output(reason="The named project is unknown or unscoped; update refused.")
                    if requested_project_id:
                        if requested_project_id in denied:
                            return output(reason="The requested project is denied; deny wins over allow.")
                        if requested_project_id not in allowed:
                            return output(reason="The requested project is unknown or outside the allowed policy.")
                        if requested_project_id != current_project_id:
                            return output(reason="A task update may not change its project.")
                    title = "" if intent.get("title") is None else str(intent["title"])
                    description = "" if intent.get("description") is None else str(intent["description"])
                    due_date = "" if intent.get("due_date") is None else str(intent["due_date"])
                    priority = intent.get("priority")
                    done = intent.get("done")
                    if priority is not None and (isinstance(priority, bool) or not isinstance(priority, (int, float))):
                        return output(reason="Priority must be a number; update refused.")
                    if done is not None and type(done) is not bool:
                        return output(reason="Done must be a boolean; update refused.")
                    if not any([title, description, due_date, priority is not None, done is not None]):
                        return output(reason="At least one task field is required for update.")

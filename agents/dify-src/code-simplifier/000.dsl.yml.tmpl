app:
  description: Bounded, comment-only simplification reviews for eligible pull requests.
  icon: "\U0001F916"
  icon_background: "#D5F5F6"
  mode: workflow
  name: __DIFY_AGENT_NAME__
  use_icon_as_answer_icon: false
dependencies: []
kind: app
version: 0.7.0
workflow:
  conversation_variables: []
  environment_variables:
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50101
      name: OPENBAO_ADDR
      value: ''
      value_type: string
      description: OpenBao base URL supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50102
      name: OPENBAO_ROLE_ID
      value: ''
      value_type: secret
      description: OpenBao AppRole role ID supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50103
      name: OPENBAO_SECRET_ID
      value: ''
      value_type: secret
      description: OpenBao AppRole secret ID supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50104
      name: GITHUB_API_BASE
      value: ''
      value_type: string
      description: GitHub API base URL supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50105
      name: GITHUB_TOKEN_MINT_PATH
      value: ''
      value_type: string
      description: Approved installation-token mint path supplied in the Dify workspace.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50107
      name: GITHUB_TOKEN_WRITE_SET
      value: ''
      value_type: string
      description: OpenBao GitHub token set used for live comment writes.
      selector: []
    - id: 448e86f5-7a8a-4f70-999f-234c9ec50108
      name: GITHUB_TOKEN_READ_SET
      value: ''
      value_type: string
      description: OpenBao read-only GitHub token set used in shadow mode.
      selector: []
  features:
    file_upload:
      enabled: false
    opening_statement: ''
    retriever_resource:
      enabled: false
    sensitive_word_avoidance:
      enabled: false
    speech_to_text:
      enabled: false
    suggested_questions: []
    suggested_questions_after_answer:
      enabled: false
    text_to_speech:
      enabled: false
  graph:
    edges:
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: http-request
          targetType: code
        id: login-parse
        source: openbao_login
        sourceHandle: source
        target: parse_openbao
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else
        id: login-gate
        source: parse_openbao
        sourceHandle: source
        target: login_ready_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: code
        id: login-failed
        source: login_ready_gate
        sourceHandle: false
        target: prepare_handback
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: http-request
          targetType: code
        id: mint-parse
        source: mint_github_token
        sourceHandle: source
        target: parse_github_token
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else
        id: token-gate
        source: parse_github_token
        sourceHandle: source
        target: token_ready_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: http-request
        id: token-ready
        source: token_ready_gate
        sourceHandle: ready
        target: get_pull_request
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: code
        id: token-failed
        source: token_ready_gate
        sourceHandle: false
        target: prepare_handback
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: http-request
          targetType: http-request
        id: pr-branch-rules
        source: get_pull_request
        sourceHandle: source
        target: get_branch_rules
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: http-request
          targetType: code
        id: rules-check
        source: get_branch_rules
        sourceHandle: source
        target: guard_pull_request
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else
        id: pr-guard-branch
        source: guard_pull_request
        sourceHandle: source
        target: pull_request_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: http-request
        id: pr-eligible
        source: pull_request_gate
        sourceHandle: eligible
        target: get_pull_files
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: code
        id: pr-ineligible
        source: pull_request_gate
        sourceHandle: false
        target: prepare_handback
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: http-request
          targetType: code
        id: files-prepare
        source: get_pull_files
        sourceHandle: source
        target: prepare_review
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else
        id: review-context-gate
        source: prepare_review
        sourceHandle: source
        target: context_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: llm
        id: review-context-safe
        source: context_gate
        sourceHandle: safe
        target: simplifier_llm
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: llm
          targetType: code
        id: llm-validate
        source: simplifier_llm
        sourceHandle: source
        target: validate_review
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: start
          targetType: code
        id: mandate-start
        source: start
        sourceHandle: source
        target: validate_mandate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else
        id: mandate-validate
        source: validate_mandate
        sourceHandle: source
        target: mandate_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: http-request
        id: mandate-valid
        source: mandate_gate
        sourceHandle: eligible
        target: openbao_login
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: end
        id: mandate-invalid
        source: mandate_gate
        sourceHandle: 'false'
        target: end_handback_mandate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: code
        id: login-token-request
        source: login_ready_gate
        sourceHandle: ready
        target: token_request
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else

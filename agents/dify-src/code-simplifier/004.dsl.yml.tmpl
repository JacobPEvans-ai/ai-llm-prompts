                body = result.get("review_body", "") if isinstance(result, dict) else ""
                if decision == "refuse" or not isinstance(body, str) or not body or SECRET_RE.search(body):
                    body, comments = generic, []
                valid_comments = []
                if isinstance(comments, list) and len(comments) <= 5:
                    for comment in comments:
                        if not isinstance(comment, dict):
                            continue
                        path, line = comment.get("path"), comment.get("line")
                        start = comment.get("start_line", line)
                        text = comment.get("body", "")
                        if path not in changed or not isinstance(line, int) or not isinstance(start, int) or start > line:
                            continue
                        if line not in changed[path] or start not in changed[path] or not isinstance(text, str) or SECRET_RE.search(text):
                            continue
                        suggestion = re.search(r"```suggestion\s*\n(.*?)\n```", text, re.S)
                        if text.count("```suggestion") != 1 or not suggestion or len(suggestion.group(1).splitlines()) > 20:
                            continue
                        if any(number not in changed[path] for number in range(start, line + 1)):
                            continue
                        valid_comments.append({"path": path, "start_line": start, "line": line, "side": "RIGHT", "body": text})
                if len({comment["path"] for comment in valid_comments}) > 5:
                    valid_comments = []
                request = {"commit_id": head_sha, "event": "COMMENT", "body": body, "comments": valid_comments}
                trace = {"repo": repo, "pr_number": pr_number, "ref": ref, "head_sha": head_sha, "actor": actor, "event": event, "strength": strength, "mode": mode}
                return {"event": "COMMENT", "request_json": json.dumps(request, ensure_ascii=False), "trace_json": json.dumps(trace, ensure_ascii=False), "status": "proposed"}

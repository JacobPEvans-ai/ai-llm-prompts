                if not isinstance(files, list) or not isinstance(rules, list) or len(rules) != 0 or len(files) > 40:
                    return {"safe": 0, "fallback_json": fallback, "changed_files_json": "[]", "review_context": "", "trace_json": trace, "status": "handback"}
                if not isinstance(requested_action, str) or SECRET_RE.search(requested_action):
                    return {"safe": 0, "fallback_json": fallback, "changed_files_json": "[]", "review_context": "", "trace_json": trace, "status": "handback"}
                total_changes = sum(int(item.get("changes", 0)) for item in files if isinstance(item, dict))
                if total_changes > 6000:
                    return {"safe": 0, "fallback_json": fallback, "changed_files_json": "[]", "review_context": "", "trace_json": trace, "status": "handback"}
                changed, context_files = [], []
                for item in files:
                    if not isinstance(item, dict):
                        return {"safe": 0, "fallback_json": fallback, "changed_files_json": "[]", "review_context": "", "trace_json": trace, "status": "handback"}
                    path, patch = item.get("filename"), item.get("patch")
                    if not isinstance(path, str) or not path or not isinstance(patch, str):
                        continue
                    if SECRET_RE.search(patch):
                        return {"safe": 0, "fallback_json": fallback, "changed_files_json": "[]", "review_context": "", "trace_json": trace, "status": "handback"}
                    new_lines, current = set(), None
                    for line in patch.splitlines():
                        match = HUNK_RE.match(line)
                        if match:
                            current = int(match.group(1))
                        elif current is not None and line.startswith("+") and not line.startswith("+++"):
                            new_lines.add(current)
                            current += 1
                        elif current is not None and line.startswith("-") and not line.startswith("---"):
                            continue
                        elif current is not None and not line.startswith("\\"):
                            current += 1
                    changed.append({"path": path, "lines": sorted(new_lines)})
                    context_files.append({"path": path, "status": item.get("status", ""), "patch": patch})
                if not context_files:
                    return {"safe": 0, "fallback_json": fallback, "changed_files_json": json.dumps(changed), "review_context": "", "trace_json": trace, "status": "handback"}
                context = {"event": event, "strength": strength, "actor": actor, "repository": repo, "pull_number": pr_number, "ref": ref, "commit_sha": head_sha,
                    "requested_action": requested_action,
                    "pull_request": {"state": pr.get("state"), "draft": pr.get("draft"), "base_repository": pr.get("base", {}).get("repo", {}).get("full_name"),
                    "base_ref": pr.get("base", {}).get("ref"), "head_repository": pr.get("head", {}).get("repo", {}).get("full_name"),
                    "head_ref": pr.get("head", {}).get("ref"), "head_sha": pr.get("head", {}).get("sha")}, "active_branch_rules": len(rules), "files": context_files}
                return {"safe": 1, "fallback_json": fallback, "changed_files_json": json.dumps(changed), "review_context": json.dumps(context, ensure_ascii=False), "trace_json": trace, "status": "proposed"}

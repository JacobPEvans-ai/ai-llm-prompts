      - data:
          code: |-
            import json

            def main(mandate_ref: str, mandate_head_sha: str, mandate_repo: str, mandate_pr_number: int, current_pr_body: str, rules_body: str) -> dict:
                try:
                    pr = json.loads(current_pr_body)
                    rules = json.loads(rules_body)
                    if not isinstance(rules, list):
                        rules = rules.get("rules", []) if isinstance(rules, dict) else None
                except (TypeError, ValueError, AttributeError):
                    return {"eligible": 0}
                base_repo = pr.get("base", {}).get("repo", {}).get("full_name", "")
                head_repo = pr.get("head", {}).get("repo", {}).get("full_name", "")
                head_ref = pr.get("head", {}).get("ref", "")
                head_sha = pr.get("head", {}).get("sha", "")
                valid = (
                    isinstance(rules, list)
                    and len(rules) == 0
                    and pr.get("state") == "open"
                    and pr.get("number") == mandate_pr_number
                    and base_repo.lower() == mandate_repo.lower()
                    and head_repo.lower() == mandate_repo.lower()
                    and head_repo.lower() == base_repo.lower()
                    and head_ref == mandate_ref
                    and head_sha == mandate_head_sha
                    and head_ref not in {"main", "develop"}
                )
                return {"eligible": 1 if valid else 0}
          code_language: python3
          desc: Refuses stale PR heads, closed PRs, protected refs, or unreadable rules.

            SECRET_RE = re.compile(r"(?i)(?:-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|github_pat_[A-Za-z0-9_]{30,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|(?:api[_-]?key|secret|token)\s*[:=]\s*['\"]?[A-Za-z0-9_./+=-]{24,})")
            HUNK_RE = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")

            def main(files_body: str, event: str, strength: str, repo: str, pr_number: int, ref: str, head_sha: str, actor: str, current_pr_body: str, rules_body: str, requested_action: str) -> dict:
                fallback = json.dumps({"event": "COMMENT", "body": "Automated review was not produced because the pull request context was unsafe or incomplete.", "comments": []})
                trace = json.dumps({"repo": repo, "pr_number": pr_number, "ref": ref, "head_sha": head_sha, "actor": actor, "event": event, "strength": strength}, ensure_ascii=False)
                try:
                    files = json.loads(files_body)
                    pr = json.loads(current_pr_body)
                    rules = json.loads(rules_body)
                    if not isinstance(rules, list):
                        rules = rules.get("rules", []) if isinstance(rules, dict) else None
                except (TypeError, ValueError):
                    return {"safe": 0, "fallback_json": fallback, "changed_files_json": "[]", "review_context": "", "trace_json": trace, "status": "handback"}

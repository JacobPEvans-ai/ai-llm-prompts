            import json
            import re

            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            SHA_RE = re.compile(r"^[0-9a-f]{40}$")

            def main(repo: str, pr_number: int, ref: str, head_sha: str, pr_body: str, rules_body: str, review_json: str) -> dict:
                try:
                    pr, rules, review = json.loads(pr_body), json.loads(rules_body), json.loads(review_json)
                    if not isinstance(rules, list):
                        rules = rules.get("rules", []) if isinstance(rules, dict) else None
                except (TypeError, ValueError, AttributeError):
                    return {"allowed": 0, "status": "handback", "reason": "write target could not be revalidated against the mandate"}
                base_repo = pr.get("base", {}).get("repo", {}).get("full_name", "")
                head = pr.get("head", {})
                head_repo = head.get("repo", {}).get("full_name", "")
                valid = (REPO_RE.fullmatch(repo) is not None and isinstance(pr_number, int) and not isinstance(pr_number, bool) and pr_number > 0
                    and bool(ref) and SHA_RE.fullmatch(head_sha) is not None and isinstance(rules, list) and not rules
                    and pr.get("state") == "open" and pr.get("number") == pr_number and base_repo.lower() == repo.lower()
                    and head_repo.lower() == repo.lower()
                    and head.get("ref") == ref and head.get("sha") == head_sha
                    and review.get("event") == "COMMENT" and review.get("commit_id") == head_sha)
                return {"allowed": 1 if valid else 0, "status": "ready" if valid else "handback",
                    "reason": "" if valid else "review write target no longer matches the mandate"}

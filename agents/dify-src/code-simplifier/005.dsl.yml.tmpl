            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            REF_RE = re.compile(r"^[^\x00-\x20~^:?*\[\\]+$")

            def main(repo: str, ref: str, head_sha: str, actor: str, event: str, strength: str, mode: str, pr_number: int) -> dict:
                reason = ""
                if not all(isinstance(value, str) and value.strip() for value in (repo, ref, head_sha, actor, event, strength, mode)):
                    reason = "required mandate fields are missing"
                elif REPO_RE.fullmatch(repo) is None:
                    reason = "repository owner must be dryvist and repository name must be valid"
                elif REF_RE.fullmatch(ref) is None or ".." in ref or "@{" in ref:
                    reason = "mandated ref is invalid"
                elif SHA_RE.fullmatch(head_sha) is None:
                    reason = "mandated head_sha is invalid"
                elif event != "pull_request":
                    reason = "event must be pull_request"
                elif mode not in {"shadow", "live"}:
                    reason = "mode must be shadow or live"
                elif not isinstance(pr_number, int) or isinstance(pr_number, bool) or pr_number <= 0:
                    reason = "pr_number must be a positive integer"
                return {"valid": 0 if reason else 1, "status": "handback" if reason else "ready", "reason": reason}

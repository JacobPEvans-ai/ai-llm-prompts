                texts = {page["page_path"]: page["text"] for page in pages}
                built = build_finder_inputs([page["page_path"] for page in pages], texts, [])
                if built["dropped"]["changed_pages"]:
                    return failed
                return {"eligible": 1, "changed_pages": built["changed_pages"], "related_pages": built["related_pages"], "known_open_fingerprints": built["known_open_fingerprints"], "dropped_json": json.dumps(built["dropped"], ensure_ascii=False)}

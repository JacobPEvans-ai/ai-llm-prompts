            import json

            __DIFY_HELPER_FINDER_INPUTS__

            def main(pages: list, select_eligible: int) -> dict:
                failed = {"eligible": 0, "changed_pages": "[]", "related_pages": "[]", "known_open_fingerprints": "[]", "dropped_json": "{}"}
                if select_eligible != 1 or not isinstance(pages, list):
                    return failed
                if any(not isinstance(page, dict) or page.get("ok") != 1 for page in pages):

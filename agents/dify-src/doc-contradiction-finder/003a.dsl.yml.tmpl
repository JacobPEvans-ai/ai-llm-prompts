      - data:
          code: |-
            import json
            import re
            from urllib.parse import quote

            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            SHA_RE = re.compile(r"^[0-9a-f]{40}$")
            MAX_PAGES = 25
            MAX_FILES = 40

            def main(repo: str, files_body: str, pr_body: str) -> dict:
                empty = {"eligible": 0, "pages": []}
                if not isinstance(repo, str) or REPO_RE.fullmatch(repo) is None:
                    return empty
                try:
                    files = json.loads(files_body)
                    pr = json.loads(pr_body)
                except (TypeError, ValueError):
                    return empty
                ref = pr.get("merge_commit_sha") if isinstance(pr, dict) else None
                if not isinstance(files, list) or len(files) > MAX_FILES:
                    return empty
                if not isinstance(ref, str) or SHA_RE.fullmatch(ref) is None:
                    return empty
                paths = []
                for item in files:
                    if not isinstance(item, dict) or not isinstance(item.get("filename"), str):
                        return empty
                    if item.get("status") == "removed" or not item["filename"].endswith(".md"):
                        continue
                    path = item["filename"]
                    if path.startswith("/") or not path.strip() or ".." in path.split("/"):
                        return empty
                    paths.append(path)
                if len(paths) > MAX_PAGES:
                    return empty
                pages = [{"page_path": path, "api_path": quote(path, safe="/"), "ref": ref} for path in dict.fromkeys(paths)]
                return {"eligible": 1, "pages": pages}
          code_language: python3
          desc: Lists the changed documentation pages of the pull request. Removed files are skipped. More than 25 pages, a path outside the repository, or a missing merge commit makes the run ineligible.
          outputs:
            eligible: {type: number, children: null}
            pages: {type: 'array[object]', children: null}
          selected: false
          title: Select changed documentation pages
          type: code
          variables:

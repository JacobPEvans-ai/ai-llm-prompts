      - data:
          code: |-
            import json
            import re

            SECRET_RE = re.compile(r"(?i)(?:-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|github_pat_[A-Za-z0-9_]{30,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|(?:api[_-]?key|secret|token)\s*[:=]\s*['\"]?[A-Za-z0-9_./+=-]{24,})")
            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            MAX_PAGES = 25

            def page_list(text):
                if not isinstance(text, str) or not text.strip():
                    return []
                value = json.loads(text)
                if not isinstance(value, list) or len(value) > MAX_PAGES:
                    raise ValueError("page list is missing or too long")
                for page in value:
                    if (not isinstance(page, dict) or not isinstance(page.get("page_path"), str)
                        or not page["page_path"] or not isinstance(page.get("text"), str)):
                        raise ValueError("page entry is malformed")
                return value

            def main(repo: str, pr_number: int, repo_body: str, pr_body: str, files_body: str, changed_pages: str, related_pages: str, known_open_fingerprints: str, build_eligible: int) -> dict:
                empty = {"eligible": 0, "context_json": "{}", "page_paths_json": "[]", "known_fingerprints_json": "[]", "page_texts_json": "{}", "findings_json": ""}
                try:
                    repo_data = json.loads(repo_body)
                    pr = json.loads(pr_body)
                    files = json.loads(files_body)
                    changed = page_list(changed_pages)
                    related = page_list(related_pages)
                    known = json.loads(known_open_fingerprints) if isinstance(known_open_fingerprints, str) and known_open_fingerprints.strip() else []
                except (TypeError, ValueError, AttributeError):
                    return empty
                if (not isinstance(repo, str) or REPO_RE.fullmatch(repo) is None
                    or not isinstance(pr_number, int) or isinstance(pr_number, bool) or pr_number <= 0
                    or not isinstance(repo_data, dict)
                    or not isinstance(repo_data.get("full_name"), str)
                    or repo_data["full_name"].lower() != repo.lower()
                    or not isinstance(pr, dict) or pr.get("number") != pr_number
                    or pr.get("state") != "closed" or pr.get("merged") is not True
                    or not isinstance(pr.get("base"), dict)
                    or not isinstance(pr["base"].get("repo"), dict)
                    or not isinstance(pr["base"]["repo"].get("full_name"), str)
                    or pr["base"]["repo"]["full_name"].lower() != repo.lower()
                    or not isinstance(files, list) or len(files) > 40
                    or build_eligible != 1
                    or not isinstance(known, list) or len(known) > 200
                    or not all(isinstance(item, str) and item for item in known)):
                    return empty
                if not changed:
                    return {"eligible": 2, "context_json": "{}", "page_paths_json": "[]", "known_fingerprints_json": "[]", "page_texts_json": "{}", "findings_json": json.dumps({"findings": []}, ensure_ascii=False)}
                changed_files, total_changes = [], 0
                for item in files:
                    if not isinstance(item, dict) or not isinstance(item.get("filename"), str):
                        return empty
                    changes = item.get("changes", 0)
                    if not isinstance(changes, int) or isinstance(changes, bool) or changes < 0:
                        return empty
                    total_changes += changes
                    if total_changes > 6000:
                        return empty
                    patch = item.get("patch", "")
                    if not isinstance(patch, str) or SECRET_RE.search(patch):
                        return empty
                    changed_files.append({"path": item["filename"], "status": item.get("status", ""), "patch": patch})
                page_paths = list(dict.fromkeys(page["page_path"] for page in changed + related))
                page_texts = {}
                for page in changed + related:
                    page_texts.setdefault(page["page_path"], page["text"])
                pr_title, pr_text = pr.get("title"), pr.get("body") or ""
                if not isinstance(pr_title, str) or not isinstance(pr_text, str):
                    return empty
                if SECRET_RE.search(pr_title) or SECRET_RE.search(pr_text):
                    return empty
                context = {
                    "repository": repo,
                    "pull_request": {
                        "number": pr_number,
                        "title": pr_title,
                        "body": pr_text,
                        "merged_at": pr.get("merged_at"),
                        "base_ref": pr.get("base", {}).get("ref"),
                    },
                    "changed_files": changed_files,
                    "changed_pages": changed,
                    "related_pages": related,
                    "known_open_fingerprints": known,
                }
                return {
                    "eligible": 1,
                    "context_json": json.dumps(context, ensure_ascii=False),
                    "page_paths_json": json.dumps(page_paths, ensure_ascii=False),
                    "known_fingerprints_json": json.dumps(known, ensure_ascii=False),
                    "page_texts_json": json.dumps(page_texts, ensure_ascii=False),
                    "findings_json": "",
                }
          code_language: python3

      - data:
          code: |-
            import json
            import re

            SEVERITIES = {"S1", "S2", "S3", "S4"}
            FINDING_KEYS = {"severity", "fingerprint", "statements", "question", "ask"}
            STATEMENT_KEYS = {"page_path", "line", "quote"}
            FINGERPRINT_RE = re.compile(r"^[a-z0-9][a-z0-9:/._-]{0,190}$")

            def normalized(text):
                # Same normalization on both sides of the quote check: each run of whitespace becomes one space.
                return " ".join(text.split())

            __DIFY_HELPER_REDACT__
            __DIFY_HELPER_JSON_FENCE__
            def main(model_text: str, page_paths_json: str, known_fingerprints_json: str, page_texts_json: str) -> dict:
                if not isinstance(model_text, str) or not model_text.strip():
                    return {"findings_json": ""}
                try:
                    result = json.loads(strip_json_fence(model_text))
                    page_paths = set(json.loads(page_paths_json))
                    known = set(json.loads(known_fingerprints_json))
                    texts = json.loads(page_texts_json)
                except (TypeError, ValueError):
                    return {"findings_json": ""}
                if not isinstance(texts, dict):
                    return {"findings_json": ""}
                if not isinstance(result, dict) or set(result) != {"findings"} or not isinstance(result["findings"], list):
                    return {"findings_json": ""}
                findings = []
                for finding in result["findings"]:
                    if not isinstance(finding, dict) or set(finding) != FINDING_KEYS:
                        return {"findings_json": ""}
                    severity, fingerprint, statements = finding["severity"], finding["fingerprint"], finding["statements"]
                    question, ask = finding["question"], finding["ask"]
                    if (severity not in SEVERITIES or not isinstance(fingerprint, str)
                        or FINGERPRINT_RE.fullmatch(fingerprint) is None
                        or not isinstance(statements, list) or not 1 <= len(statements) <= 6
                        or not isinstance(question, str) or not question.startswith("Which is right?")
                        or not all(marker in question for marker in ("A:", "B:", "Neither:"))
                        or not isinstance(ask, bool)):
                        return {"findings_json": ""}
                    safe_statements = []
                    for statement in statements:
                        if not isinstance(statement, dict) or set(statement) != STATEMENT_KEYS:
                            return {"findings_json": ""}
                        path, line, quote = statement["page_path"], statement["line"], statement["quote"]
                        if (not isinstance(path, str) or path not in page_paths or "://" in path
                            or ".." in path.split("/")
                            or not isinstance(line, int) or isinstance(line, bool) or line < 1
                            or not isinstance(texts.get(path), str)
                            or not isinstance(quote, str) or not quote.strip() or len(quote) > 300):
                            return {"findings_json": ""}
                        safe_statements.append({"page_path": path, "line": line, "quote": quote})
                    if not all(normalized(redact(s["quote"])) in normalized(redact(texts[s["page_path"]])) for s in safe_statements):
                        continue  # A quote that is not verbatim in its redacted cited page drops only this finding.
                    header = "\n".join([fingerprint, question] + [s["page_path"] for s in safe_statements])
                    if redact(header) != header:
                        return {"findings_json": ""}
                    security = any(needs_redaction(s["quote"]) for s in safe_statements)
                    findings.append({
                        "severity": severity,
                        "fingerprint": fingerprint,
                        "statements": [dict(s, quote=redact(s["quote"])) for s in safe_statements],
                        "question": question,
                        # A finding whose quote needed redaction is a security finding: it goes to Zammad, never to Slack.
                        "security": security,
                        # Dedupe is enforced here as well as in the prompt: a tracked fingerprint is never asked again.
                        "ask": ask and fingerprint not in known and not security,
                    })
                return {"findings_json": json.dumps({"findings": findings}, ensure_ascii=False)}
          code_language: python3
          desc: Accepts only schema-valid findings whose pages were supplied. Quotes are redacted with the shared rule and must match their redacted cited page verbatim. A finding whose quote needed redaction is marked security and is never asked.
          outputs:
            findings_json: {type: string, children: null}
          selected: false
          title: Validate contradiction findings
          type: code
          variables:
            - {variable: model_text, value_selector: [docs_updater_llm, text]}
            - {variable: page_paths_json, value_selector: [prepare_context, page_paths_json]}
            - {variable: known_fingerprints_json, value_selector: [prepare_context, known_fingerprints_json]}
            - {variable: page_texts_json, value_selector: [prepare_context, page_texts_json]}
        height: 54
        id: validate_proposal

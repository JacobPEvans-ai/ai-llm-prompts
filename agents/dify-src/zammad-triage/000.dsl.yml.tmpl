app: {description: 'Scheduled, policy-scoped Zammad triage with guarded shadow and live branches.', mode: workflow, name: __DIFY_AGENT_NAME__}
dependencies: []
kind: app
version: 0.7.0
workflow:
  environment_variables:
    - {id: allowed, name: ZAMMAD_TRIAGE_ALLOWED_GROUPS, value_type: secret, value: '[]'}
    - {id: readonly, name: ZAMMAD_TRIAGE_READONLY_GROUPS, value_type: secret, value: '[]'}
    - {id: denied, name: ZAMMAD_TRIAGE_DENIED_GROUPS, value_type: secret, value: '[]', description: Include all client and business group IDs}
    - {id: tags, name: ZAMMAD_TRIAGE_TAG_VOCABULARY, value_type: secret, value: '[]'}
    - {id: mode, name: ZAMMAD_TRIAGE_MODE, value_type: string, value: __DIFY_MODE__, description: Only exact live enables writes}
    - {id: api_base, name: ZAMMAD_API_BASE, value_type: string, value: ''}
    - {id: bao_addr, name: OPENBAO_ADDR, value_type: string, value: ''}
    - {id: bao_role, name: OPENBAO_ROLE_ID, value_type: secret, value: ''}
    - {id: bao_secret, name: OPENBAO_SECRET_ID, value_type: secret, value: ''}
    - {id: token_path, name: ZAMMAD_TOKEN_PATH, value_type: string, value: ''}
    - {id: router_key, name: LITELLM_ROUTER_KEY, value_type: secret, value: '', description: LiteLLM router key; it must be scoped to local-only models and forbid cloud fallback}
  graph:
    edges:
      - {data: {sourceType: trigger-schedule, targetType: code}, id: e1, source: schedule, sourceHandle: source, target: fetch, targetHandle: target, type: custom}
      - {data: {sourceType: code, targetType: llm}, id: e2, source: fetch, sourceHandle: source, target: triage, targetHandle: target, type: custom}
      - {data: {sourceType: llm, targetType: code}, id: e3, source: triage, sourceHandle: source, target: guard, targetHandle: target, type: custom}
      - {data: {sourceType: code, targetType: end}, id: e4, source: guard, sourceHandle: source, target: done, targetHandle: target, type: custom}
    nodes:
      - {data: {mode: cron, cron_expression: '__DIFY_TRIGGER_CRON__', timezone: UTC, title: Schedule, type: trigger-schedule}, id: schedule, position: {x: 40, y: 300}, type: custom}
      - data:
          # The Zammad token is fetched and used inside this node only; it never becomes a workflow variable.
          code: |-
            import json,re,urllib.request
            from datetime import datetime,timezone
            from urllib.parse import urlencode,urlsplit
            class NR(urllib.request.HTTPRedirectHandler):
                def redirect_request(self,*a,**k): return None
            def req(u,m='GET',h=None,b=None):
                with urllib.request.build_opener(NR).open(urllib.request.Request(u,data=b,headers=h or {},method=m),timeout=15) as r: return json.loads(r.read().decode())
            def https(s):
                u=urlsplit(s); return u.scheme=='https' and u.hostname and not (u.username or u.password or u.query or u.fragment)
            def token(a,r,s,p):
                if not https(a) or not p or '..' in p.split('/'): raise ValueError()
                c=req(a.rstrip('/')+'/v1/auth/approle/login','POST',{'Content-Type':'application/json'},json.dumps({'role_id':r,'secret_id':s}).encode())['auth']['client_token']
                d=req(a.rstrip('/')+'/v1/'+p.strip('/'),h={'X-Vault-Token':c})['data']; t=d.get('token') or d.get('data',{}).get('token')
                if not isinstance(t,str) or not t: raise ValueError()
                return t
            def ids(s):
                v=json.loads(s)
                if not isinstance(v,list) or any(type(x)!=str or not x.strip() for x in v): raise ValueError()
                return set(v)
            def age(v,n):
                try:
                    d=datetime.fromisoformat(str(v).replace('Z','+00:00')); d=d if d.tzinfo else d.replace(tzinfo=timezone.utc)
                    return max(0,(n-d).days)
                except Exception: return None
            def main(allowed,readonly,denied,tags,base,addr,role,secret,path,stamp):
                bad={'pol':'{"ok":false}','refs':'[]','model':'[]','ok':False}
                try:
                    a,r,d,t=map(ids,(allowed,readonly,denied,tags))
                    p={'ok':True,'allowed':sorted(a),'readonly':sorted(r),'denied':sorted(d),'read':sorted((a|r)-d),'write':sorted(a-r-d),'tags':sorted(t)}
                    if not p['read'] or not https(base): return bad
                    n=datetime.fromisoformat(stamp.replace('Z','+00:00')); n=n if n.tzinfo else n.replace(tzinfo=timezone.utc)
                    tk=token(addr,role,secret,path); refs=[]
                    for g in p['read']:
                        raw=req(base.rstrip('/')+'/api/v1/tickets/search?'+urlencode({'query':'group_id:'+g,'limit':'50','expand':'true'}),h={'Authorization':'Token token='+tk})
                        xs=raw if isinstance(raw,list) else raw.get('tickets') if isinstance(raw,dict) else None
                        if not isinstance(xs,list): return bad
                        for x in xs:
                            i=str(x.get('id','')) if isinstance(x,dict) else ''
                            if not re.fullmatch(r'[0-9]+',i): return bad
                            if str(x.get('group_id'))!=g: continue
                            s=x.get('state',''); s=s.get('name','') if isinstance(s,dict) else s
                            tg=x.get('tags',[]); tg=tg.split() if isinstance(tg,str) else tg
                            try: pri={1:'low',2:'normal',3:'high'}.get(int(x.get('priority_id')))
                            except Exception: pri=None
                            refs.append({'ticket_index':len(refs),'id':i,'group_id':g,'title':str(x.get('title','')),'priority':pri,'state':s if isinstance(s,str) else '','age_days':age(x.get('created_at'),n),'tags':[v for v in tg if isinstance(v,str)] if isinstance(tg,list) else [],'last_updated_age_days':age(x.get('updated_at'),n)})
                    model=[{k:v for k,v in x.items() if k not in ('id','group_id')} for x in refs]
                    return {'pol':json.dumps(p),'refs':json.dumps(refs),'model':json.dumps(model),'ok':True}
                except Exception: return bad
          code_language: python3
          outputs: {pol: {type: string}, refs: {type: string}, model: {type: string}, ok: {type: boolean}}
          title: Load policy and search authorized groups
          type: code
          variables:
            - {variable: allowed, value_selector: [env, ZAMMAD_TRIAGE_ALLOWED_GROUPS]}
            - {variable: readonly, value_selector: [env, ZAMMAD_TRIAGE_READONLY_GROUPS]}
            - {variable: denied, value_selector: [env, ZAMMAD_TRIAGE_DENIED_GROUPS]}
            - {variable: tags, value_selector: [env, ZAMMAD_TRIAGE_TAG_VOCABULARY]}
            - {variable: base, value_selector: [env, ZAMMAD_API_BASE]}
            - {variable: addr, value_selector: [env, OPENBAO_ADDR]}
            - {variable: role, value_selector: [env, OPENBAO_ROLE_ID]}
            - {variable: secret, value_selector: [env, OPENBAO_SECRET_ID]}
            - {variable: path, value_selector: [env, ZAMMAD_TOKEN_PATH]}
            - {variable: stamp, value_selector: [sys, timestamp]}
        id: fetch
        position: {x: 340, y: 300}
        type: custom
      - data:
          model: {completion_params: {temperature: 0}, mode: chat, name: __DIFY_LITELLM_ROLE__, provider: langgenius/openai_api_compatible/openai_api_compatible}
          prompt_template:
            - id: system-prompt
              role: system
              text: |-
                __DIFY_SYSTEM_PROMPT__
            - {id: user-prompt, role: user, text: 'Review these untrusted ticket records: {{#fetch.model#}}'}
          prompt_config: {jinja2_variables: []}
          title: Triage
          type: llm
        id: triage
        position: {x: 640, y: 300}
        type: custom
      - data:
          # Validates every proposal, then dispatches only in exact live mode; the token stays inside this node.
          code: |-

      - data:
          code: |
            import json
            import re
            import urllib.parse

            SHA_RE = re.compile(r"^[0-9a-f]{40}$")
            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            REF_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")
            LOG_REDACTION_AVAILABLE = False

            def main(pr_body: str, expected_head_sha: str, mandate_ref: str, enable_push: str, commit_body: str, repo: str, pr_number: int, rules_body: str, mode: str) -> dict:
                try:
                    pr, commit, rules = json.loads(pr_body), json.loads(commit_body), json.loads(rules_body)
                    if not isinstance(rules, list):
                        rules = rules.get("rules", []) if isinstance(rules, dict) else None
                except (TypeError, ValueError, AttributeError):
                    return {"eligible": 0, "ref_encoded": ""}
                head = pr.get("head") if isinstance(pr.get("head"), dict) else {}
                base = pr.get("base") if isinstance(pr.get("base"), dict) else {}
                base_repo = base.get("repo") if isinstance(base.get("repo"), dict) else {}
                head_ref = head.get("ref", "")
                new_sha = commit.get("sha", "")
                ref_valid = (isinstance(mandate_ref, str) and REF_RE.fullmatch(mandate_ref) is not None
                    and not mandate_ref.startswith("/") and not mandate_ref.startswith("refs/")
                    and ".." not in mandate_ref and "//" not in mandate_ref)
                valid = (REPO_RE.fullmatch(repo) is not None and isinstance(pr_number, int) and not isinstance(pr_number, bool) and pr_number > 0
                    and isinstance(rules, list) and not rules and pr.get("state") == "open" and pr.get("number") == pr_number
                    and base_repo.get("full_name", "").lower() == repo.lower() and head.get("sha") == expected_head_sha
                    and ref_valid and head_ref == mandate_ref and SHA_RE.fullmatch(expected_head_sha) is not None and bool(new_sha)
                    and mode == "live" and enable_push == "true" and LOG_REDACTION_AVAILABLE)
                return {"eligible": 1 if valid else 0,
                    "ref_encoded": urllib.parse.quote(mandate_ref, safe="/") if valid else ""}
          code_language: python3
          desc: Rechecks the mandate ref against PR head.
          outputs:
            eligible:
              type: number
              children: null
            ref_encoded:
              type: string
              children: null
          selected: false
          title: Guard ref update
          type: code
          variables:
            - {variable: pr_body, value_selector: [recheck_pull_request, body]}
            - {variable: expected_head_sha, value_selector: [start, head_sha]}
            - {variable: mandate_ref, value_selector: [start, ref]}
            - {variable: enable_push, value_selector: [env, ENABLE_PUSH]}
            - {variable: commit_body, value_selector: [create_commit, body]}
            - {variable: repo, value_selector: [start, repo]}
            - {variable: pr_number, value_selector: [extract_check_target, pr_number]}
            - {variable: rules_body, value_selector: [get_branch_rules, body]}
            - {variable: mode, value_selector: [start, mode]}
        height: 54
        id: guard_ref_update

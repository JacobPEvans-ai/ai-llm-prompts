                linked = prs[0] if len(prs) == 1 and isinstance(prs[0], dict) else {}
                number = linked.get("number")
                valid = (check.get("id") == check_run_id and check.get("status") == "completed" and check.get("conclusion") == "failure"
                    and check.get("head_sha") == head_sha and check.get("head_branch") == ref and len(prs) == 1
                    and isinstance(number, int) and not isinstance(number, bool) and number > 0)
                return {"eligible": 1 if valid else 0, "pr_number": number if valid else 0,
                    "status": "ready" if valid else "handback", "reason": "" if valid else "check run does not match the mandate or has no single linked PR"}

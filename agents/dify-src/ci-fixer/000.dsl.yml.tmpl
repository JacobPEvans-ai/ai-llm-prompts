app:
  description: Bounded CI repair for eligible same-repository pull requests; source
    writes stay disabled until log redaction is available.
  icon: "\U0001F916"
  icon_background: "#D5F5F6"
  mode: workflow
  name: ci-fixer
  use_icon_as_answer_icon: false
dependencies: []
kind: app
version: 0.7.0
workflow:
  conversation_variables: []
  environment_variables:
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000001
      name: OPENBAO_ADDR
      value: ''
      value_type: string
      description: OpenBao base URL supplied in the Dify workspace.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000002
      name: OPENBAO_ROLE_ID
      value: ''
      value_type: secret
      description: OpenBao AppRole role ID supplied in the Dify workspace.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000003
      name: OPENBAO_SECRET_ID
      value: ''
      value_type: secret
      description: OpenBao AppRole secret ID supplied in the Dify workspace.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000004
      name: GITHUB_API_BASE
      value: ''
      value_type: string
      description: GitHub API base URL supplied in the Dify workspace.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000005
      name: GITHUB_TOKEN_MINT_PATH
      value: ''
      value_type: string
      description: Approved installation-token mint path supplied in the Dify workspace.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000007
      name: ENABLE_PUSH
      value: 'false'
      value_type: string
      description: Source writes require the exact value true and all code guards.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000008
      name: GITHUB_TOKEN_WRITE_SET
      value: ''
      value_type: string
      description: OpenBao GitHub token set used for live comments and source writes.
      selector: []
    - id: 8a4a2c01-1dc7-4ec0-a5e7-5c4120000009
      name: GITHUB_TOKEN_READ_SET
      value: ''
      value_type: string
      description: OpenBao read-only GitHub token set used in shadow mode.
      selector: []
  features:
    file_upload:
      enabled: false
    opening_statement: ''
    retriever_resource:
      enabled: false
    sensitive_word_avoidance:
      enabled: false
    speech_to_text:
      enabled: false
    suggested_questions: []
    suggested_questions_after_answer:
      enabled: false
    text_to_speech:
      enabled: false
  graph:
    edges:
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: http-request
          targetType: code
        id: login-parse
        source: openbao_login
        sourceHandle: source
        target: parse_openbao
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: code
          targetType: if-else
        id: login-branch
        source: parse_openbao
        sourceHandle: source
        target: login_gate
        targetHandle: target
        type: custom
        zIndex: 0
      - data:
          isInIteration: false
          isInLoop: false
          sourceType: if-else
          targetType: code
        id: login-failed
        source: login_gate
        sourceHandle: false

                base_repo = base.get("repo") if isinstance(base.get("repo"), dict) else {}
                tree = commit.get("tree") if isinstance(commit.get("tree"), dict) else {}
                changed_lines, counts_valid = 0, isinstance(files, list) and len(files) <= 3
                if counts_valid:
                    for item in files:
                        if not isinstance(item, dict):
                            counts_valid = False
                            break
                        additions, deletions = item.get("additions"), item.get("deletions")
                        if any(not isinstance(value, int) or isinstance(value, bool) or value < 0 for value in (additions, deletions)):
                            counts_valid = False
                            break
                        changed_lines += additions + deletions
                context_text = json.dumps({"check": check, "annotations": annotations, "files": files}, ensure_ascii=False)
                safe_context = not SECRET_RE.search(context_text)
                valid = (isinstance(annotations, list) and isinstance(rules, list) and len(rules) == 0 and pr.get("state") == "open"
                    and pr.get("number") == payload_pr_number and base_repo.get("full_name", "").lower() == payload_repo.lower()
                    and head_repo.get("full_name", "").lower() == payload_repo.lower() and head.get("ref") == payload_head_ref
                    and head.get("sha") == payload_head_sha and payload_head_ref not in {"main", "develop"}
                    and SHA_RE.fullmatch(payload_head_sha) is not None and check.get("id") == payload_check_run_id
                    and check.get("status") == "completed" and check.get("conclusion") == "failure" and check.get("head_sha") == payload_head_sha
                    and check.get("head_branch") == payload_head_ref and counts_valid and changed_lines <= 120
                    and SHA_RE.fullmatch(tree.get("sha", "")) is not None)
                comment_allowed = (pr.get("number") == payload_pr_number and isinstance(payload_pr_number, int) and not isinstance(payload_pr_number, bool)
                    and payload_pr_number > 0 and base_repo.get("full_name", "").lower() == payload_repo.lower()
                    and head.get("ref") == payload_head_ref and head.get("sha") == payload_head_sha)
                model_allowed = bool(valid and safe_context and (mode == "shadow" or LOG_REDACTION_AVAILABLE))
                return {"eligible": 1 if valid else 0, "comment_allowed": 1 if comment_allowed else 0,
                    "model_allowed": 1 if model_allowed else 0, "tree_sha": tree.get("sha", "") if valid else "",
                    "current_head_sha": head.get("sha", ""), "changed_lines": changed_lines,
                    "reason": "" if model_allowed else "bounded context or secret scan did not authorize model input"}

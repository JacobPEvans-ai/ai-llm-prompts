                try:
                    result, files = json.loads(model_text), json.loads(files_body)
                    pr, rules = json.loads(current_pr_body), json.loads(rules_body)
                    if not isinstance(rules, list):
                        rules = rules.get("rules", []) if isinstance(rules, dict) else None
                except (TypeError, ValueError, AttributeError):
                    result, files, pr, rules = {}, [], {}, None
                changed_paths = {item.get("filename") for item in files if isinstance(item, dict)} if isinstance(files, list) else set()
                patches = result.get("patches", []) if isinstance(result, dict) else []
                valid = isinstance(patches, list) and 0 < len(patches) <= 3 and result.get("decision") == "commit"

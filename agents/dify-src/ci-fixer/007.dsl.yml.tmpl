      - data:
          code: |
            import re
            from urllib.parse import quote

            SHA_RE = re.compile(r"^[0-9a-f]{40}$")
            REPO_RE = re.compile(r"^dryvist/[A-Za-z0-9_.-]+$")
            REF_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]*$")

            def main(repo: str, mandate_ref: str, head_sha: str, actor: str, event: str, strength: str, mode: str, check_run_id: int) -> dict:
                reason = ""
                if not all(isinstance(value, str) and value.strip() for value in (repo, mandate_ref, head_sha, actor, event, strength, mode)):
                    reason = "required mandate fields are missing"
                elif REPO_RE.fullmatch(repo) is None:
                    reason = "repository owner must be dryvist and repository name must be valid"
                elif (REF_RE.fullmatch(mandate_ref) is None or mandate_ref.startswith("/")
                        or mandate_ref.startswith("refs/") or ".." in mandate_ref or "//" in mandate_ref or "@{" in mandate_ref):
                    reason = "mandated ref is invalid"
                elif SHA_RE.fullmatch(head_sha) is None:
                    reason = "mandated head_sha is invalid"
                elif event != "check_run":
                    reason = "event must be check_run"
                elif mode not in {"shadow", "live"}:
                    reason = "mode must be shadow or live"
                elif not isinstance(check_run_id, int) or isinstance(check_run_id, bool) or check_run_id <= 0:
                    reason = "check_run_id must be a positive integer"
                return {"valid": 0 if reason else 1,
                    "encoded_ref": quote(mandate_ref, safe="/") if not reason else "",
                    "status": "handback" if reason else "ready", "reason": reason}
          code_language: python3
          desc: Rejects incomplete or widened mandates.
          outputs:
            valid:
              type: number
              children: null
            encoded_ref:
              type: string
              children: null
            status:
              type: string
              children: null
            reason:
              type: string
              children: null
          variables:
            - {variable: repo, value_selector: [start, repo]}
            - {variable: mandate_ref, value_selector: [start, ref]}
            - {variable: head_sha, value_selector: [start, head_sha]}

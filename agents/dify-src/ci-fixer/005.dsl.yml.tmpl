                total_changed_lines, diffs_valid, selected = 0, True, None
                if valid:
                    for patch in patches:
                        if not isinstance(patch, dict):
                            valid = False
                            break
                        path, content = patch.get("path"), patch.get("content")
                        if not isinstance(path, str) or not isinstance(content, str) or path not in changed_paths:
                            valid = False
                            break
                        parts = path.split("/")
                        if path.startswith("/") or ".." in parts or any(part in DENIED_PARTS for part in parts):
                            valid = False
                            break
                        if path.endswith((".lock", ".sum", ".min.js", ".min.css")) or SECRET_RE.search(content):
                            valid = False
                            break
                        diff = patch.get("diff")
                        if not isinstance(diff, str) or not any(line.startswith("@@") for line in diff.splitlines()):
                            diffs_valid, valid = False, False
                            break
                        total_changed_lines += sum(1 for line in diff.splitlines() if (line.startswith("+") and not line.startswith("+++")) or (line.startswith("-") and not line.startswith("---")))
                        if selected is None:
                            selected = (path, content)
                line_limit_ok = isinstance(patches, list) and diffs_valid and total_changed_lines <= 120
                head = pr.get("head") if isinstance(pr.get("head"), dict) else {}
                base = pr.get("base") if isinstance(pr.get("base"), dict) else {}
                head_repo = head.get("repo") if isinstance(head.get("repo"), dict) else {}
                base_repo = base.get("repo") if isinstance(base.get("repo"), dict) else {}
                target_ok = (REPO_RE.fullmatch(repo) is not None and isinstance(pr_number, int) and not isinstance(pr_number, bool) and pr_number > 0
                    and SHA_RE.fullmatch(head_sha) is not None and pr.get("state") == "open" and pr.get("number") == pr_number
                    and base_repo.get("full_name", "").lower() == repo.lower() and head_repo.get("full_name", "").lower() == repo.lower()
                    and head.get("ref") == ref and head.get("sha") == head_sha and isinstance(rules, list) and not rules)
                push_allowed = bool(valid and line_limit_ok and eligible == 1 and target_ok and strength == "explicit"
                    and mode == "live" and enable_push == "true" and LOG_REDACTION_AVAILABLE and len(patches) == 1)
                path, content = selected if selected else ("", "")
                artifact = json.dumps({"decision": "commit", "patches": patches}, ensure_ascii=False) if valid and line_limit_ok else json.dumps({"decision": "comment", "patches": []})
                trace = json.dumps({"repo": repo, "pr_number": pr_number, "ref": ref, "head_sha": head_sha, "actor": actor, "event": event, "strength": strength, "mode": mode}, ensure_ascii=False)
                status = "proposed" if mode == "shadow" and valid and line_limit_ok and target_ok and eligible == 1 else "handback" if not target_ok or eligible != 1 else "refused"
                reason = "" if status == "proposed" else "patch or target failed validation, or live writes remain fail-closed"
                return {"push_allowed": 1 if push_allowed else 0, "path": path, "content_json": json.dumps(content, ensure_ascii=False),
                    "commit_message": "fix: repair CI failure", "artifact_json": artifact, "trace_json": trace, "status": status, "reason": reason}

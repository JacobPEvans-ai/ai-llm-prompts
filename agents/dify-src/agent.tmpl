{{- /* Resolve profiles with make resolve-agents; render with make render-dify. */ -}}
{{- define "resolve" -}}
  {{- test.Assert "invalid agent name" (regexp.Match `^[a-z0-9]+(-[a-z0-9]+)*$` .name) -}}
  {{- $agent := . -}}
  {{- $profile := dict -}}
  {{- if coll.Has . "extends" -}}
    {{- test.Assert "invalid profile name" (and (test.IsKind "string" .extends) (ne .extends "")) -}}
  {{- end -}}
  {{- with (index . "extends") -}}
    {{- test.Assert "invalid profile name" (and (regexp.Match `^[a-z0-9]+(-[a-z0-9]+)*$` .) (ne . "defaults")) -}}
    {{- $profile = file.Read (printf "agents/profiles/%s.yaml" .) | data.YAML -}}
    {{- $defaults := file.Read "agents/profiles/defaults.yaml" | data.YAML -}}
    {{- range $layer := coll.Slice $defaults $profile -}}
      {{- range $field := coll.Slice "extends" "name" "identity" "api_key_ref" "prompt" "eval_set" -}}
        {{- test.Assert (printf "profiles cannot set %s" $field) (not (coll.Has $layer $field)) -}}
      {{- end -}}
    {{- end -}}
    {{- test.Assert "prompt and eval_set follow from name" (and (not (coll.Has $agent "prompt")) (not (coll.Has $agent "eval_set"))) -}}
    {{- $profile = coll.Merge $profile $defaults -}}
    {{- $agent = coll.Merge $agent $profile -}}
    {{- $agent = coll.Set "prompt" (printf "agents/prompts/%s.md" $agent.name) $agent -}}
    {{- $agent = coll.Set "eval_set" (printf "agents/evals/%s.yaml" $agent.name) $agent -}}
  {{- end -}}
  {{- dict "agent" $agent "profile" $profile | data.ToJSON -}}
{{- end -}}
{{- define "prompt" -}}
  {{- test.Assert "prompt paths must name repository files under agents/" (and (strings.HasPrefix "agents/" .) (not (strings.Contains ".." .))) -}}
  {{- $text := file.Read . -}}
  {{- if strings.HasPrefix "---\n" $text -}}
    {{- $parts := strings.SplitN "\n---\n" 2 $text -}}
    {{- test.Assert "unterminated prompt frontmatter" (eq (len $parts) 2) -}}
    {{- index $parts 1 | strings.TrimSpace -}}
  {{- else -}}{{- $text | strings.TrimSpace -}}{{- end -}}
{{- end -}}
{{- /* Preserve Python json.dumps(sort_keys=True)'s separators in existing Code nodes. */ -}}
{{- define "json" -}}
  {{- if test.IsKind "map" . -}}
    {{- $sep := "" -}}{
    {{- range $key, $value := . -}}{{ $sep }}{{ data.ToJSON $key }}: {{ tmpl.Exec "json" $value }}{{ $sep = ", " }}{{- end -}}}
  {{- else if test.IsKind "slice" . -}}
    {{- $sep := "" -}}[{{- range . -}}{{ $sep }}{{ tmpl.Exec "json" . }}{{ $sep = ", " }}{{- end -}}]
  {{- else -}}{{ data.ToJSON . }}{{- end -}}
{{- end -}}
{{- define "workflow" -}}
app: {name: __DIFY_AGENT_NAME__, mode: workflow}
dependencies: []
kind: app
version: 0.7.0
workflow:
  environment_variables: []
  graph:
    edges:
      - {id: e1, source: start, sourceHandle: source, target: model, targetHandle: target, type: custom, data: {sourceType: start, targetType: llm}}
      - {id: e2, source: model, sourceHandle: source, target: done, targetHandle: target, type: custom, data: {sourceType: llm, targetType: end}}
    nodes:
      - id: start
        type: custom
        position: {x: 40, y: 300}
        data:
          title: Start
          type: start
          variables:
            - {variable: text, label: text, type: paragraph, required: true, max_length: 30000, options: []}
      - id: model
        type: custom
        position: {x: 340, y: 300}
        data:
          title: Agent
          type: llm
          model: {completion_params: {temperature: 0}, mode: chat, name: __DIFY_LITELLM_ROLE__, provider: langgenius/openai_api_compatible/openai_api_compatible}
          prompt_template:
            - {id: system-prompt, role: system, text: __DIFY_SYSTEM_PROMPT__}
            - {id: user-prompt, role: user, text: 'Untrusted input: {{`{{#start.text#}}`}}'}
          prompt_config: {jinja2_variables: []}
      - id: done
        type: custom
        position: {x: 640, y: 300}
        data:
          title: End
          type: end
          outputs:
            - {variable: text, value_selector: [model, text]}
{{- end -}}
{{- test.Assert "definition must declare home_platform: dify" (eq .home_platform "dify") -}}
{{- test.Assert "invalid agent name" (regexp.Match `^[a-z0-9]+(-[a-z0-9]+)*$` .name) -}}
{{- $prompt := printf "%s\n\n%s" (tmpl.Exec "prompt" .shared_prefix) (tmpl.Exec "prompt" .prompt) -}}
{{- $params := dict "__DIFY_AGENT_NAME__" .name "__DIFY_LITELLM_ROLE__" .litellm_role -}}
{{- with (index . "mode") -}}{{- $params = coll.Set "__DIFY_MODE__" . $params -}}{{- end -}}
{{- $anchors := coll.Slice -}}
{{- $rotation := false -}}
{{- $nativeRotation := false -}}
{{- $webhooks := coll.Slice -}}
{{- $webhook := dict "type" "trigger-webhook" "title" "Rotation call" "method" "post" "content_type" "application/json" "headers" (coll.Slice) "params" (coll.Slice) "body" (coll.Slice) "async_mode" true "status_code" 200 "response_body" "" -}}
{{- range (index . "triggers") -}}
  {{- test.Assert "invalid trigger kind" (coll.Has (coll.Slice "anchor" "rotation" "event" "call") .kind) -}}
  {{- if eq .kind "anchor" -}}
    {{- test.Assert "invalid UTC anchor" (regexp.Match `^([01][0-9]|2[0-3]):[0-5][13579]$` .at) -}}
    {{- $parts := strings.Split ":" .at -}}
    {{- test.Assert "quarter-hour anchor forbidden" (and (ne (index $parts 1) "15") (ne (index $parts 1) "45")) -}}
    {{- $anchors = coll.Append . $anchors -}}
  {{- else if eq .kind "rotation" -}}
    {{- test.Assert "invalid rotation interval" (regexp.Match `^[1-9][0-9]*[mhd]$` .every) -}}
    {{- $rotation = true -}}
    {{- if lt (conv.ToInt (index $ "tier")) 2 -}}
      {{- $nativeRotation = true -}}
      {{- $cron := coll.JQ `
        .every as $every | ($every[:-1] | tonumber) as $n | $every[-1:] as $unit |
        if $unit == "m" and $n >= 2 and $n <= 60 and (60 % $n == 0) then
          ([range(7; 60; $n), range(7 - $n; 0; -$n)] | sort | map(tostring) | join(",")) + " * * * *"
        elif $unit == "h" and $n <= 24 and (24 % $n == 0) then "7 */" + ($n | tostring) + " * * *"
        elif $unit == "d" and $n == 1 then "7 0 * * *"
        else error("native rotation interval cannot be expressed safely as cron") end` . -}}
      {{- $params = coll.Set "__DIFY_TRIGGER_CRON__" $cron $params -}}
    {{- end -}}
  {{- else if eq .kind "event" -}}
    {{- $webhooks = coll.Append (coll.Merge (dict "title" (printf "%s webhook" .source)) $webhook) $webhooks -}}
  {{- end -}}
{{- end -}}
{{- test.Assert "native rotation cannot share an anchor" (not (and $nativeRotation (gt (len $anchors) 0))) -}}
{{- test.Assert "Dify template supports one anchor" (le (len $anchors) 1) -}}
{{- range $anchors -}}
  {{- $parts := strings.Split ":" .at -}}
  {{- $days := "*" -}}
  {{- if coll.Has . "days" -}}
    {{- test.Assert "invalid anchor days" (coll.JQ `.days | type == "array" and length > 0 and all(.[]; IN("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")) and (unique | length) == length` .) -}}
    {{- $days = coll.JQ `[.days[] | {Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 0}[.]] | sort | map(tostring) | join(",")` . -}}
  {{- end -}}
  {{- $params = coll.Set "__DIFY_TRIGGER_CRON__" (printf "%s %s * * %s" (index $parts 1) (index $parts 0) $days) $params -}}
{{- end -}}
{{- with (index . "github_reader") -}}{{- $params = coll.Set "__DIFY_GITHUB_TOKEN_REF__" .github_token_ref $params -}}{{- end -}}
{{- with (index . "output_schema") -}}
  {{- $schema := tmpl.Exec "json" . | strings.ReplaceAll "\\" "\\\\" | strings.ReplaceAll "'" "\\'" -}}
  {{- $params = coll.Set "__DIFY_OUTPUT_SCHEMA__" (printf "'%s'" $schema) $params -}}
{{- end -}}
{{- range $name := coll.Slice "redact" "json_fence" "finder_inputs" "envelope" -}}
  {{- $body := file.Read (printf "%s/helpers/%s.py" (tmpl.PathDir) $name) | strings.TrimSuffix "\n" -}}
  {{- $params = coll.Set (printf "__DIFY_HELPER_%s__" (strings.ToUpper $name)) $body $params -}}
{{- end -}}
{{- with (index . "mcp_servers") -}}
  {{- $agent := $ -}}
  {{- $params = coll.Set "__DIFY_MCP_SERVER__" (index . 0) $params -}}
  {{- $operations := coll.Slice -}}
  {{- range $agent.tools -}}
    {{- $parts := strings.SplitN "." 2 . -}}
    {{- if eq (len $parts) 2 -}}
      {{- $params = coll.Set "__DIFY_TOOL_NAME__" (index $parts 0) $params -}}
      {{- $operation := index $parts 1 -}}
      {{- $params = coll.Set (printf "__DIFY_TOOL_OPERATION_%s__" (strings.ToUpper $operation)) $operation $params -}}
      {{- $operations = coll.Append (printf "'%s'" $operation) $operations -}}
    {{- end -}}
  {{- end -}}
  {{- $params = coll.Set "__DIFY_TOOL_OPERATIONS__" (printf "{%s}" (join (coll.Sort $operations) ", ")) $params -}}
{{- end -}}
{{- $dsl := tmpl.Exec "workflow" . | data.YAML -}}
{{- with (index . "dify") -}}{{- $dsl = . -}}{{- end -}}
{{- test.Assert "renderer owns schedules" (eq (coll.JQ `[.. | objects | keys[] | select(. == "cron" or . == "cadence")] | length` .) 0) -}}
{{- test.Assert "renderer owns cron expressions" (eq (coll.JQ `[.. | objects | select(has("cron_expression")) | .cron_expression | select(. != "__DIFY_TRIGGER_CRON__")] | length` .) 0) -}}
{{- if or $rotation (gt (len $anchors) 0) -}}
  {{- if and $rotation (not $nativeRotation) (eq (len $webhooks) 0) -}}
    {{- $webhooks = coll.Append $webhook $webhooks -}}
  {{- end -}}
  {{- $start := dict -}}
  {{- if or $nativeRotation (gt (len $anchors) 0) -}}
    {{- $start = dict "type" "trigger-schedule" "title" "Schedule" "mode" "cron" "cron_expression" (index $params "__DIFY_TRIGGER_CRON__") "timezone" "UTC" -}}
  {{- else -}}
    {{- $start = index $webhooks 0 -}}
    {{- $webhooks = slice $webhooks 1 -}}
  {{- end -}}
  {{- test.Assert "timed workflow requires one entry node" (eq (coll.JQ `[.workflow.graph.nodes[] | select(.data.type == "start" or .data.type == "trigger-schedule")] | length` $dsl) 1) -}}
  {{- $dsl = dict "dsl" $dsl "start" $start "webhooks" $webhooks | coll.JQ `
    .start as $start | .webhooks as $hooks | .dsl |
    (.workflow.graph.nodes[] | select(.data.type == "start" or .data.type == "trigger-schedule")) as $entry |
    .workflow.graph |= (
      .nodes |= map(if .id == $entry.id then .data = $start else . end) |
      .edges |= map(if .source == $entry.id then .data.sourceType = $start.type else . end) |
      .edges as $edges |
      .nodes += [$hooks | to_entries[] | $entry + {id: ("webhook-" + (.key | tostring)), data: .value}] |
      .edges += [$hooks | to_entries[] | .key as $i | $edges[] | select(.source == $entry.id) |
        .id += ("-webhook-" + ($i | tostring)) | .source = ("webhook-" + ($i | tostring)) | .data.sourceType = $hooks[$i].type]
    )` -}}
  {{- if not (coll.Has . "dify") -}}
    {{- $dsl = coll.JQ `(.workflow.graph.nodes[] | select(.data.type == "llm") | .data.prompt_template[] | select(.role == "user") | .text) = "Run at {{#sys.timestamp#}}."` $dsl -}}
  {{- end -}}
{{- end -}}
{{- test.Assert "Start node and trigger nodes cannot coexist" (coll.JQ `(.workflow.graph.nodes // [] | map(.data.type)) as $types | (($types | index("start")) == null or ([$types[] | select(startswith("trigger-"))] | length) == 0)` $dsl) -}}
{{- /* Substitute data values, never evaluate prompts or Code-node source as templates. */ -}}
{{- $dsl = dict "dsl" $dsl "params" $params | coll.JQ `.params as $params | .dsl | walk(if type == "string" then reduce ($params | to_entries[]) as $p (.; split($p.key) | join($p.value)) else . end)` -}}
{{- test.Assert "workflow must contain exactly one system prompt" (eq (coll.JQ `[.. | strings | select(contains("__DIFY_SYSTEM_PROMPT__"))] | length` $dsl) 1) -}}
{{- $source := data.ToJSON $dsl | strings.ReplaceAll "__DIFY_SYSTEM_PROMPT__" "" -}}
{{- test.Assert "workflow has unresolved Dify parameters" (not (regexp.Match `__DIFY_[A-Z0-9_]+__` $source)) -}}
{{- $dsl = dict "dsl" $dsl "prompt" $prompt | coll.JQ `.prompt as $prompt | .dsl | walk(if type == "string" then split("__DIFY_SYSTEM_PROMPT__") | join($prompt) else . end)` -}}
# Generated from agents/{{ .name }}.yaml, agents/dify-src/agent.tmpl, and {{ .shared_prefix }} + {{ .prompt }}; edit sources, then run make render-dify.
{{- /* Quote the YAML 1.1 value indicator for Dify's PyYAML loader. */}}
{{ data.ToYAML $dsl | strings.ReplaceAll ": =\n" ": '='\n" | strings.TrimSuffix "\n" }}

{{- /* Resolve profiles with make resolve-agents; render with make render-dify. */ -}}
{{- define "resolve" -}}
  {{- test.Assert "invalid agent name" (regexp.Match `^[a-z0-9]+(-[a-z0-9]+)*$` .name) -}}
  {{- $agent := . -}}
  {{- $profile := dict -}}
  {{- if coll.Has . "extends" -}}
    {{- test.Assert "invalid profile name" (and (test.IsKind "string" .extends) (ne .extends "")) -}}
  {{- end -}}
  {{- with (index . "extends") -}}
    {{- test.Assert "invalid profile name" (and (regexp.Match `^[a-z0-9]+(-[a-z0-9]+)*$` .) (ne . "defaults")) -}}
    {{- $profile = file.Read (printf "agents/profiles/%s.yaml" .) | data.YAML -}}
    {{- $defaults := file.Read "agents/profiles/defaults.yaml" | data.YAML -}}
    {{- range $layer := coll.Slice $defaults $profile -}}
      {{- range $field := coll.Slice "extends" "name" "identity" "api_key_ref" "prompt" "eval_set" -}}
        {{- test.Assert (printf "profiles cannot set %s" $field) (not (coll.Has $layer $field)) -}}
      {{- end -}}
    {{- end -}}
    {{- test.Assert "prompt and eval_set follow from name" (and (not (coll.Has $agent "prompt")) (not (coll.Has $agent "eval_set"))) -}}
    {{- $profile = coll.Merge $profile $defaults -}}
    {{- $agent = coll.Merge $agent $profile -}}
    {{- $agent = coll.Set "prompt" (printf "agents/prompts/%s.md" $agent.name) $agent -}}
    {{- $agent = coll.Set "eval_set" (printf "agents/evals/%s.yaml" $agent.name) $agent -}}
  {{- end -}}
  {{- dict "agent" $agent "profile" $profile | data.ToJSON -}}
{{- end -}}
{{- define "prompt" -}}
  {{- test.Assert "prompt paths must name repository files under agents/" (and (strings.HasPrefix "agents/" .) (not (strings.Contains ".." .))) -}}
  {{- $text := file.Read . -}}
  {{- if strings.HasPrefix "---\n" $text -}}
    {{- $parts := strings.SplitN "\n---\n" 2 $text -}}
    {{- test.Assert "unterminated prompt frontmatter" (eq (len $parts) 2) -}}
    {{- index $parts 1 | strings.TrimSpace -}}
  {{- else -}}{{- $text | strings.TrimSpace -}}{{- end -}}
{{- end -}}
{{- /* Preserve Python json.dumps(sort_keys=True)'s separators in existing Code nodes. */ -}}
{{- define "json" -}}
  {{- if test.IsKind "map" . -}}
    {{- $sep := "" -}}{
    {{- range $key, $value := . -}}{{ $sep }}{{ data.ToJSON $key }}: {{ tmpl.Exec "json" $value }}{{ $sep = ", " }}{{- end -}}}
  {{- else if test.IsKind "slice" . -}}
    {{- $sep := "" -}}[{{- range . -}}{{ $sep }}{{ tmpl.Exec "json" . }}{{ $sep = ", " }}{{- end -}}]
  {{- else -}}{{ data.ToJSON . }}{{- end -}}
{{- end -}}
{{- /* Dotted tools whose prefix is a declared server name individual MCP tools; other dotted tools except a2a.* are the subcommand form. */ -}}
{{- define "mcp-classification" -}}
  {{- coll.JQ `
    . as $agent |
    [($agent.tools // [])[] | (index(".")) as $dot | select($dot != null) |
      {prefix: .[:$dot], name: .[$dot + 1:]}] as $dotted |
    {
      individual: [$dotted[] | select(. as $part | ($agent.mcp_servers // []) | index($part.prefix)) |
        {server: .prefix, tool: .name}],
      subcommand: [$dotted[] | select(. as $part | ($agent.mcp_servers // []) | index($part.prefix) | not) |
        select(.prefix != "a2a")]
    }` . | data.ToJSON -}}
{{- end -}}
{{- define "workflow" -}}
app: {name: __DIFY_AGENT_NAME__, mode: workflow}
dependencies: []
kind: app
version: 0.7.0
workflow:
  environment_variables: []
  graph:
    edges:
      - {id: e1, source: start, sourceHandle: source, target: model, targetHandle: target, type: custom, data: {sourceType: start, targetType: llm}}
      - {id: e2, source: model, sourceHandle: source, target: done, targetHandle: target, type: custom, data: {sourceType: llm, targetType: end}}
    nodes:
      - id: start
        type: custom
        position: {x: 40, y: 300}
        data:
          title: Start
          type: start
          variables:
            - {variable: text, label: text, type: paragraph, required: true, max_length: 30000, options: []}
      - id: model
        type: custom
        position: {x: 340, y: 300}
        data:
          title: Agent
          type: llm
          model: {completion_params: {temperature: 0}, mode: chat, name: __DIFY_LITELLM_ROLE__, provider: langgenius/openai_api_compatible/openai_api_compatible}
          prompt_template:
            - {id: system-prompt, role: system, text: __DIFY_SYSTEM_PROMPT__}
            - {id: user-prompt, role: user, text: 'Untrusted input: {{`{{#start.text#}}`}}'}
          prompt_config: {jinja2_variables: []}
      - id: done
        type: custom
        position: {x: 640, y: 300}
        data:
          title: End
          type: end
          outputs:
            - {variable: text, value_selector: [model, text]}
{{- end -}}
{{- define "trigger-input" -}}
import json

__DIFY_HELPER_REDACT__

__DIFY_HELPER_JSON_FENCE__

__DIFY_HELPER_ENVELOPE__


def main(timestamp, event=None):
    result = {"timestamp": timestamp, "kind": "schedule"}
    if __TRIGGER_EVENT__:
        problem = schema_problem(event, {"type": "object", "required": ["body"], "properties": {"body": {"type": "object"}}})
        if problem:
            return {
                "text": json.dumps(build_envelope("stop", "invalid triggering event", None)),
                "stop": True,
            }
        result = {"timestamp": timestamp, "kind": "event", "event": event["body"]}
    text = json.dumps(redact({"status": "ok", "reason": "", "result": result}))
    if len(text) > 30000:
        return {
            "text": json.dumps(build_envelope("stop", "trigger input exceeds 30000 characters", None)),
            "stop": True,
        }
    return {"text": text, "stop": False}
{{- end -}}
{{- define "delivery-code" -}}
AGENT = {{ data.ToJSON .name }}
MAX_CHARS = {{ .max_chars }}
TRUNCATED = "\n[truncated]"
TRUSTED_SLACK_HOSTS = ("slack.com",)


__DIFY_HELPER_REDACT__


__DIFY_HELPER_SLACK_DELIVERY__


MARKER_RE = re.compile(re.escape(REDACTED) + "|" + re.escape(LINK_REMOVED))


def cut_point(text, limit):
    # A cut never lands inside a redaction marker or a link placeholder; it moves to that marker's start.
    for marker in MARKER_RE.finditer(text):
        if marker.start() < limit < marker.end():
            return marker.start()
    return limit


def bounded(text):
    # Secrets and links leave the full text before the clip, so a cut can never leave part of either. After the clip the
    # text is redacted and stripped again, then escaped. Escaping can grow the text, so the clip budget shrinks until it fits.
    full = strip_urls(redact(strip_invisible(text)))
    budget = MAX_CHARS
    while True:
        cut = full if len(full) <= budget else full[: cut_point(full, max(0, budget - len(TRUNCATED)))] + TRUNCATED
        posted = escape_mrkdwn(strip_urls(redact(cut)))
        if len(posted) <= MAX_CHARS:
            return posted
        budget = min(budget - 1, budget * MAX_CHARS // len(posted))


def summary(outputs):
    text = outputs.get("text")
    if isinstance(text, str):
        body = text
    else:
        body = "\n".join(
            key + ": " + (value if isinstance(value, str) else json.dumps(value, ensure_ascii=False))
            for key, value in sorted(outputs.items())
        )
    # Model and fetch text is redacted here; links the template builds (the dashboard URL) are never added to body.
    return bounded(body) or "(no output)"


def main(run_timestamp, bot_token, api_base, digest_channel, failure_channel, dashboard_url, input_value, fetch_error="", **outputs):
    stamp = datetime.datetime.fromtimestamp(float(run_timestamp), datetime.timezone.utc)
    if str(fetch_error or "").strip():
        fail(api_base, bot_token, failure_channel, digest_channel, dashboard_url, stamp, "fetch failed: " + str(fetch_error))
    if not fetched(input_value):
        return {"status": "skipped"}
    body = summary(outputs)
    return {"status": post_digest(api_base, bot_token, digest_channel, failure_channel, dashboard_url, stamp, body)}
{{- end -}}
{{- define "failure-code" -}}
AGENT = {{ data.ToJSON .name }}
TRUSTED_SLACK_HOSTS = ("slack.com",)


__DIFY_HELPER_REDACT__


__DIFY_HELPER_SLACK_DELIVERY__


def main(run_timestamp, bot_token, api_base, digest_channel, failure_channel, dashboard_url):
    stamp = datetime.datetime.fromtimestamp(float(run_timestamp), datetime.timezone.utc)
    fail(api_base, bot_token, failure_channel, digest_channel, dashboard_url, stamp, "run failed")
{{- end -}}
{{- test.Assert "definition must declare home_platform: dify" (eq .home_platform "dify") -}}
{{- test.Assert "invalid agent name" (regexp.Match `^[a-z0-9]+(-[a-z0-9]+)*$` .name) -}}
{{- if and (not (coll.Has . "dify")) (coll.Has . "tools") (gt (len .tools) 0) -}}
  {{- test.Assert "generic workflows with tools must be shadow proposals" (eq (index . "mode") "shadow") -}}
{{- end -}}
{{- $prompt := printf "%s\n\n%s" (tmpl.Exec "prompt" .shared_prefix) (tmpl.Exec "prompt" .prompt) -}}
{{- $params := dict "__DIFY_AGENT_NAME__" .name "__DIFY_LITELLM_ROLE__" .litellm_role -}}
{{- with (index . "mode") -}}{{- $params = coll.Set "__DIFY_MODE__" . $params -}}{{- end -}}
{{- $anchors := coll.Slice -}}
{{- $rotation := false -}}
{{- $nativeRotation := false -}}
{{- $webhooks := coll.Slice -}}
{{- $webhook := dict "type" "trigger-webhook" "title" "Rotation call" "method" "post" "content_type" "application/json" "headers" (coll.Slice) "params" (coll.Slice) "body" (coll.Slice) "async_mode" true "status_code" 200 "response_body" "" -}}
{{- range (index . "triggers") -}}
  {{- test.Assert "invalid trigger kind" (coll.Has (coll.Slice "anchor" "rotation" "event" "call") .kind) -}}
  {{- if eq .kind "anchor" -}}
    {{- test.Assert "invalid UTC anchor" (regexp.Match `^([01][0-9]|2[0-3]):[0-5][13579]$` .at) -}}
    {{- $parts := strings.Split ":" .at -}}
    {{- test.Assert "quarter-hour anchor forbidden" (and (ne (index $parts 1) "15") (ne (index $parts 1) "45")) -}}
    {{- $anchors = coll.Append . $anchors -}}
  {{- else if eq .kind "rotation" -}}
    {{- test.Assert "invalid rotation interval" (regexp.Match `^[1-9][0-9]*[mhd]$` .every) -}}
    {{- $rotation = true -}}
    {{- if coll.Has . "minute" -}}
      {{- test.Assert "minute applies only to every: 1h" (eq .every "1h") -}}
      {{- test.Assert "minute must be an unquoted whole number" (and (test.IsKind "int" .minute) (regexp.Match `^[0-9]+$` (printf "%v" .minute))) -}}
      {{- test.Assert "hourly minute must be odd, below 60, and neither 15 nor 45" (and (regexp.Match `[13579]$` (printf "%v" .minute)) (lt (conv.ToInt .minute) 60) (ne (conv.ToInt .minute) 15) (ne (conv.ToInt .minute) 45)) -}}
    {{- else if eq .every "1h" -}}
      {{- test.Assert "every: 1h requires an odd minute" false -}}
    {{- end -}}
    {{- if lt (conv.ToInt (index $ "tier")) 2 -}}
      {{- $nativeRotation = true -}}
      {{- $cron := coll.JQ `
        .every as $every | ($every[:-1] | tonumber) as $n | $every[-1:] as $unit |
        if $unit == "m" and $n >= 2 and $n <= 60 and (60 % $n == 0) then
          ([range(7; 60; $n), range(7 - $n; 0; -$n)] | sort | map(select(IN(0, 15, 30, 45) | not)) | map(tostring) | join(",")) + " * * * *"
        elif $unit == "h" and $n <= 24 and (24 % $n == 0) then ((if $n == 1 then (.minute | tostring) else "7" end) + " */" + ($n | tostring) + " * * *")
        elif $unit == "d" and $n == 1 then "7 0 * * *"
        else error("native rotation interval cannot be expressed safely as cron") end` . -}}
      {{- $params = coll.Set "__DIFY_TRIGGER_CRON__" $cron $params -}}
    {{- end -}}
  {{- else if eq .kind "event" -}}
    {{- $webhooks = coll.Append (coll.Merge (dict "title" (printf "%s webhook" .source)) $webhook) $webhooks -}}
  {{- end -}}
{{- end -}}
{{- test.Assert "native rotation cannot share an anchor" (not (and $nativeRotation (gt (len $anchors) 0))) -}}
{{- test.Assert "Dify template supports one anchor" (le (len $anchors) 1) -}}
{{- range $anchors -}}
  {{- $parts := strings.Split ":" .at -}}
  {{- $days := "*" -}}
  {{- if coll.Has . "days" -}}
    {{- test.Assert "invalid anchor days" (coll.JQ `.days | type == "array" and length > 0 and all(.[]; IN("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")) and (unique | length) == length` .) -}}
    {{- $days = coll.JQ `[.days[] | {Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 0}[.]] | sort | map(tostring) | join(",")` . -}}
  {{- end -}}
  {{- $params = coll.Set "__DIFY_TRIGGER_CRON__" (printf "%s %s * * %s" (index $parts 1) (index $parts 0) $days) $params -}}
{{- end -}}
{{- with (index . "github_reader") -}}{{- $params = coll.Set "__DIFY_GITHUB_TOKEN_REF__" .github_token_ref $params -}}{{- end -}}
{{- with (index . "output_schema") -}}
  {{- $schema := tmpl.Exec "json" . | strings.ReplaceAll "\\" "\\\\" | strings.ReplaceAll "'" "\\'" -}}
  {{- $params = coll.Set "__DIFY_OUTPUT_SCHEMA__" (printf "'%s'" $schema) $params -}}
{{- end -}}
{{- range $name := coll.Slice "redact" "json_fence" "finder_inputs" "envelope" "slack_delivery" -}}
  {{- $body := file.Read (printf "%s/helpers/%s.py" (tmpl.PathDir) $name) | strings.TrimSuffix "\n" -}}
  {{- $params = coll.Set (printf "__DIFY_HELPER_%s__" (strings.ToUpper $name)) $body $params -}}
{{- end -}}
{{- with (index . "mcp_servers") -}}
  {{- $params = coll.Set "__DIFY_MCP_SERVER__" (index . 0) $params -}}
  {{- $classified := tmpl.Exec "mcp-classification" $ | data.JSON -}}
  {{- $prefixes := coll.Slice -}}
  {{- $operations := coll.Slice -}}
  {{- range $classified.subcommand -}}
    {{- $params = coll.Set "__DIFY_TOOL_NAME__" .prefix $params -}}
    {{- $params = coll.Set (printf "__DIFY_TOOL_OPERATION_%s__" (strings.ToUpper .name)) .name $params -}}
    {{- $operations = coll.Append (printf "'%s'" .name) $operations -}}
    {{- $prefixes = coll.Append .prefix $prefixes -}}
  {{- end -}}
  {{- test.Assert "subcommand tools must share one MCP tool prefix" (coll.JQ `unique | length < 2` $prefixes) -}}
  {{- if $operations -}}
    {{- $params = coll.Set "__DIFY_TOOL_OPERATIONS__" (printf "{%s}" (join (coll.Sort $operations) ", ")) $params -}}
  {{- end -}}
{{- end -}}
{{- $dsl := tmpl.Exec "workflow" . | data.YAML -}}
{{- with (index . "dify") -}}{{- $dsl = . -}}{{- end -}}
{{- /* Dify's LLM node schema requires context: every LLM node gets the disabled default unless it sets its own. */ -}}
{{- $dsl = coll.JQ `(.workflow.graph.nodes[]? | select(.data.type == "llm") | .data) |= ({context: {enabled: false, variable_selector: []}} + .)` $dsl -}}
{{- test.Assert "renderer owns schedules" (eq (coll.JQ `[.. | objects | keys[] | select(. == "cron" or . == "cadence")] | length` .) 0) -}}
{{- test.Assert "renderer owns cron expressions" (eq (coll.JQ `[.. | objects | select(has("cron_expression")) | .cron_expression | select(. != "__DIFY_TRIGGER_CRON__")] | length` .) 0) -}}
{{- if or $rotation (gt (len $anchors) 0) (and (not (coll.Has . "dify")) (gt (len $webhooks) 0)) -}}
  {{- if and $rotation (not $nativeRotation) (eq (len $webhooks) 0) -}}
    {{- $webhooks = coll.Append $webhook $webhooks -}}
  {{- end -}}
  {{- $start := dict -}}
  {{- if or $nativeRotation (gt (len $anchors) 0) -}}
    {{- $start = dict "type" "trigger-schedule" "title" "Schedule" "mode" "cron" "cron_expression" (index $params "__DIFY_TRIGGER_CRON__") "timezone" "UTC" -}}
  {{- else -}}
    {{- $start = index $webhooks 0 -}}
    {{- $webhooks = slice $webhooks 1 -}}
  {{- end -}}
  {{- test.Assert "timed workflow requires one entry node" (eq (coll.JQ `[.workflow.graph.nodes[] | select(.data.type == "start" or .data.type == "trigger-schedule")] | length` $dsl) 1) -}}
  {{- $dsl = dict "dsl" $dsl "start" $start "webhooks" $webhooks | coll.JQ `
    .start as $start | .webhooks as $hooks | .dsl |
    (.workflow.graph.nodes[] | select(.data.type == "start" or .data.type == "trigger-schedule")) as $entry |
    .workflow.graph |= (
      .nodes |= map(if .id == $entry.id then .data = $start else . end) |
      .edges |= map(if .source == $entry.id then .data.sourceType = $start.type else . end) |
      .edges as $edges |
      .nodes += [$hooks | to_entries[] | $entry + {id: ("webhook-" + (.key | tostring)), data: .value}] |
      .edges += [$hooks | to_entries[] | .key as $i | $edges[] | select(.source == $entry.id) |
        .id += ("-webhook-" + ($i | tostring)) | .source = ("webhook-" + ($i | tostring)) | .data.sourceType = $hooks[$i].type]
    )` -}}
  {{- if and (not (coll.Has . "dify")) (coll.JQ `any(.triggers[]; .kind == "event")` .) -}}
    {{- $dsl = dict "dsl" $dsl "code" (tmpl.Exec "trigger-input" .) | coll.JQ `
      .code as $code | .dsl | .workflow.graph |= (
        [.nodes[] | select(.data.type | startswith("trigger-"))] as $entries |
        .nodes += [$entries[] | (.data.type == "trigger-webhook") as $event | {
          id: (.id + "-input"), type: "custom", position: {x: 140, y: 300},
          data: {title: "Bound and redact trigger input", type: "code", code_language: "python3",
            code: ($code | split("__TRIGGER_EVENT__") | join(if $event then "True" else "False" end)),
            variables: ([{variable: "timestamp", value_selector: ["sys", "timestamp"]}] +
              if .data.type == "trigger-webhook" then [{variable: "event", value_selector: [.id, "_webhook_raw"]}] else [] end),
            outputs: {text: {type: "string"}, stop: {type: "boolean"}}}
        }] |
        .nodes += [($entries | to_entries[]) | .key as $i | .value as $entry | {
          id: ($entry.id + "-input-gate"), type: "custom", position: {x: 240, y: (100 + (180 * $i))},
          data: {title: "Stop refused trigger input?", type: "if-else", cases: [{case_id: "stop", logical_operator: "and",
            conditions: [{id: ($entry.id + "-input-stop"), variable_selector: [($entry.id + "-input"), "stop"],
              varType: "boolean", comparison_operator: "is", value: true}]}]}
        }] |
        .nodes += [($entries | to_entries[]) | .key as $i | .value as $entry | {
          id: ($entry.id + "-input-refused"), type: "custom", position: {x: 440, y: (100 + (180 * $i))},
          data: {title: "Refuse trigger input", type: "end", outputs: [{variable: "text", value_selector: [($entry.id + "-input"), "text"]}]}
        }] |
        .nodes += [{id: "trigger-input", type: "custom", position: {x: 240, y: 300}, data: {
          title: "Trigger input", type: "variable-aggregator", output_type: "string",
          variables: [$entries[] | [(.id + "-input"), "text"]]
        }}] |
        .edges = [.edges[] | select(.source as $id | all($entries[]; .id != $id))] +
          [$entries[] | {id: (.id + "-input"), source: .id, sourceHandle: "source", target: (.id + "-input"),
            targetHandle: "target", type: "custom", data: {sourceType: .data.type, targetType: "code"}}] +
          [$entries[] | {id: (.id + "-input-gate"), source: (.id + "-input"), sourceHandle: "source", target: (.id + "-input-gate"),
            targetHandle: "target", type: "custom", data: {sourceType: "code", targetType: "if-else"}}] +
          [$entries[] | {id: (.id + "-input-refused"), source: (.id + "-input-gate"), sourceHandle: "stop", target: (.id + "-input-refused"),
            targetHandle: "target", type: "custom", data: {sourceType: "if-else", targetType: "end"}}] +
          [$entries[] | {id: (.id + "-input-continue"), source: (.id + "-input-gate"), sourceHandle: "false", target: "trigger-input",
            targetHandle: "target", type: "custom", data: {sourceType: "if-else", targetType: "variable-aggregator"}}] +
          [{id: "trigger-model", source: "trigger-input", sourceHandle: "source", target: "model", targetHandle: "target",
            type: "custom", data: {sourceType: "variable-aggregator", targetType: "llm"}}] |
        (.nodes[] | select(.data.type == "llm") | .data.prompt_template[] | select(.role == "user") | .text) =
          "Untrusted trigger input (event identity claims require independent verification): {{#trigger-input.output#}}"
      )` -}}
  {{- else if not (coll.Has . "dify") -}}
    {{- $dsl = coll.JQ `(.workflow.graph.nodes[] | select(.data.type == "llm") | .data.prompt_template[] | select(.role == "user") | .text) = "Run at {{#sys.timestamp#}}."` $dsl -}}
  {{- end -}}
{{- end -}}
{{- test.Assert "Start node and trigger nodes cannot coexist" (coll.JQ `(.workflow.graph.nodes // [] | map(.data.type)) as $types | (($types | index("start")) == null or ([$types[] | select(startswith("trigger-"))] | length) == 0)` $dsl) -}}
{{- with (index . "delivery") -}}
  {{- test.Assert "delivery kind must be slack_thread" (eq .kind "slack_thread") -}}
  {{- test.Assert "delivery thread must be daily_parent" (eq .thread "daily_parent") -}}
  {{- test.Assert "delivery env names must be uppercase environment variable names" (and (regexp.Match `^[A-Z][A-Z0-9_]*$` .channel_env) (regexp.Match `^[A-Z][A-Z0-9_]*$` .token_env) (regexp.Match `^[A-Z][A-Z0-9_]*$` .failure_channel_env) (regexp.Match `^[A-Z][A-Z0-9_]*$` .dashboard_url_env)) -}}
  {{- test.Assert "failure channel env must differ from the delivery channel env" (ne .failure_channel_env .channel_env) -}}
  {{- test.Assert "delivery env names must be distinct" (and (ne .token_env .channel_env) (ne .token_env .failure_channel_env) (ne .dashboard_url_env .channel_env) (ne .dashboard_url_env .failure_channel_env) (ne .dashboard_url_env .token_env)) -}}
  {{- test.Assert "delivery max_chars must be a whole number from 100 to 10000" (and (regexp.Match `^[0-9]+$` (printf "%v" .max_chars)) (ge (conv.ToInt .max_chars) 100) (le (conv.ToInt .max_chars) 10000)) -}}
  {{- test.Assert "delivery input_from must name a node and an output" (eq (len .input_from) 2) -}}
  {{- test.Assert "delivery input_from must name an existing node" (coll.JQ `.input_from[0] as $n | any(.dsl.workflow.graph.nodes[]; .id == $n)` (dict "dsl" $dsl "input_from" .input_from)) -}}
  {{- test.Assert "delivery has an unknown field" (coll.JQ `keys - ["channel_env","dashboard_url_env","error_from","failure_channel_env","input_from","kind","max_chars","thread","token_env"] | length == 0` .) -}}
  {{- if coll.Has . "error_from" -}}
    {{- test.Assert "delivery error_from must name a node and an output" (eq (len .error_from) 2) -}}
    {{- test.Assert "delivery error_from must name an existing node" (coll.JQ `.error_from[0] as $n | any(.dsl.workflow.graph.nodes[]; .id == $n)` (dict "dsl" $dsl "error_from" .error_from)) -}}
  {{- end -}}
  {{- $envs := coll.Slice -}}
  {{- $envs = coll.Append (dict "id" "delivery-token" "name" .token_env "value_type" "secret" "value" "" "description" "Slack bot token for agent digests") $envs -}}
  {{- $envs = coll.Append (dict "id" "delivery-api-base" "name" "SLACK_API_BASE" "value_type" "string" "value" "" "description" "Approved Slack Web API base") $envs -}}
  {{- $envs = coll.Append (dict "id" "delivery-channel" "name" .channel_env "value_type" "string" "value" "" "description" "Slack channel for agent digests") $envs -}}
  {{- $envs = coll.Append (dict "id" "delivery-failure-channel" "name" .failure_channel_env "value_type" "string" "value" "" "description" "Slack channel for agent failure notices") $envs -}}
  {{- $envs = coll.Append (dict "id" "delivery-dashboard" "name" .dashboard_url_env "value_type" "string" "value" "" "description" "Dashboard URL for agent failure notices") $envs -}}
  {{- $common := coll.Slice -}}
  {{- $common = coll.Append (dict "variable" "run_timestamp" "value_selector" (coll.Slice "sys" "timestamp")) $common -}}
  {{- $common = coll.Append (dict "variable" "bot_token" "value_selector" (coll.Slice "env" .token_env)) $common -}}
  {{- $common = coll.Append (dict "variable" "api_base" "value_selector" (coll.Slice "env" "SLACK_API_BASE")) $common -}}
  {{- $common = coll.Append (dict "variable" "digest_channel" "value_selector" (coll.Slice "env" .channel_env)) $common -}}
  {{- $common = coll.Append (dict "variable" "failure_channel" "value_selector" (coll.Slice "env" .failure_channel_env)) $common -}}
  {{- $common = coll.Append (dict "variable" "dashboard_url" "value_selector" (coll.Slice "env" .dashboard_url_env)) $common -}}
  {{- $deliverInputs := coll.Append (dict "variable" "input_value" "value_selector" (coll.Slice (index .input_from 0) (index .input_from 1))) $common -}}
  {{- if coll.Has . "error_from" -}}
    {{- $deliverInputs = coll.Append (dict "variable" "fetch_error" "value_selector" (coll.Slice (index .error_from 0) (index .error_from 1))) $deliverInputs -}}
  {{- end -}}
  {{- $deliverCode := tmpl.Exec "delivery-code" (dict "name" $.name "max_chars" .max_chars) -}}
  {{- $failureCode := tmpl.Exec "failure-code" (dict "name" $.name) -}}
  {{- /* Each end node gets a Code node before it, which posts the output. Each llm node routes failures to one failure notice and its own end node. */ -}}
  {{- $dsl = dict "dsl" $dsl "envs" $envs "code" $deliverCode "inputs" $deliverInputs | coll.JQ `
    . as $c | $c.dsl | .workflow.environment_variables += $c.envs | .workflow.graph |= (
      (.nodes | map(select(.data.type == "end") | .id)) as $ends |
      .nodes += [.nodes[] | select(.data.type == "end") | {id: ("deliver-" + .id), type: "custom", position: {x: .position.x, y: (.position.y + 160)}, data: {title: "Deliver output", type: "code", code_language: "python3", code: $c.code, variables: ($c.inputs + [.data.outputs[] | {variable: .variable, value_selector: .value_selector}]), outputs: {status: {type: "string", children: null}}}}] |
      .edges |= map(if (.target as $t | any($ends[]; . == $t)) then .target = ("deliver-" + .target) | .targetHandle = "target" | .data.targetType = "code" else . end) |
      .edges += [$ends[] | {id: ("deliver-" + . + "-end"), source: ("deliver-" + .), sourceHandle: "source", target: ., targetHandle: "target", type: "custom", data: {sourceType: "code", targetType: "end"}}]
    )` -}}
  {{- $dsl = coll.JQ `.workflow.graph.nodes |= map(if .data.type == "end" then .data.outputs += [{variable: "delivery_status", value_selector: [("deliver-" + .id), "status"]}] else . end)` $dsl -}}
  {{- $dsl = dict "dsl" $dsl "code" $failureCode "inputs" $common | coll.JQ `
    . as $c | $c.dsl | .workflow.graph |= (
      .nodes |= map(if .data.type == "llm" then .data.error_strategy = "fail-branch" else . end) |
      .nodes += [.nodes[] | select(.data.type == "llm") | {id: ("notify-failure-" + .id), type: "custom", position: {x: .position.x, y: (.position.y + 240)}, data: {title: "Notify agent failure", type: "code", code_language: "python3", code: $c.code, variables: $c.inputs, outputs: {text: {type: "string", children: null}}}}] |
      .nodes += [.nodes[] | select(.data.type == "llm") | {id: ("failed-" + .id), type: "custom", position: {x: (.position.x + 200), y: (.position.y + 240)}, data: {title: "Failed run", type: "end", outputs: [{variable: "text", value_selector: [("notify-failure-" + .id), "text"]}]}}] |
      .edges += [.nodes[] | select(.data.type == "llm") | ({id: (.id + "-failed"), source: .id, sourceHandle: "fail-branch", target: ("notify-failure-" + .id), targetHandle: "target", type: "custom", data: {sourceType: "llm", targetType: "code"}}, {id: ("notify-failure-" + .id + "-end"), source: ("notify-failure-" + .id), sourceHandle: "source", target: ("failed-" + .id), targetHandle: "target", type: "custom", data: {sourceType: "code", targetType: "end"}})]
    )` -}}
{{- end -}}
{{- with (index . "dify_pr_queue_shadow") -}}
  {{- test.Assert "Dify PR queue shadow flow only applies to pr-keeper" (and (eq $.name "pr-keeper") (eq . true)) -}}
  {{- $shadow := file.Read "agents/dify-src/pr-keeper-shadow.yml" | data.YAML -}}
  {{- $dsl = dict "dsl" $dsl "shadow" $shadow | coll.JQ `
    . as $c | $c.dsl |
    .workflow.environment_variables += $c.shadow.environment_variables |
    .workflow.graph |= (
      .edges += $c.shadow.edges |
      .nodes += $c.shadow.nodes
    )` -}}
{{- end -}}
{{- /* Substitute data values, never evaluate prompts or Code-node source as templates. */ -}}
{{- $dsl = dict "dsl" $dsl "params" $params | coll.JQ `.params as $params | .dsl | walk(if type == "string" then reduce ($params | to_entries[]) as $p (.; split($p.key) | join($p.value)) else . end)` -}}
{{- test.Assert "workflow must contain exactly one system prompt" (eq (coll.JQ `[.. | strings | select(contains("__DIFY_SYSTEM_PROMPT__"))] | length` $dsl) 1) -}}
{{- $source := data.ToJSON $dsl | strings.ReplaceAll "__DIFY_SYSTEM_PROMPT__" "" -}}
{{- test.Assert "workflow has unresolved Dify parameters" (not (regexp.Match `__DIFY_[A-Z0-9_]+__` $source)) -}}
{{- with (index . "dify") -}}
  {{- $classified := tmpl.Exec "mcp-classification" $ | data.JSON -}}
  {{- $report := dict "graph" $dsl "classified" $classified | coll.JQ `
    .graph as $graph | .classified as $c |
    [($graph.workflow.graph.nodes // [])[] |
      select(.data.type == "tool" and .data.provider_type == "mcp")] as $nodes |
    [$nodes[] | {server: .data.provider_name, tool: .data.tool_name}] as $pairs |
    {
      undeclared: [$pairs[] | select(. as $pair |
        (($c.individual | map(.server) | index($pair.server)) and
          (($c.individual | index($pair)) | not)))],
      subcommand: [$nodes[] | select(. as $node |
        $c.individual | map(.server) | index($node.data.provider_name)) |
        select((.data.tool_parameters // {}) | has("subcommand"))],
      missing: [$c.individual[] | select(. as $pair | ($pairs | index($pair)) | not)]
    }` -}}
  {{- test.Assert "MCP tool nodes must name an individually declared tool" (eq (coll.JQ `.undeclared | length` $report) 0) -}}
  {{- test.Assert "individually declared MCP tools cannot take a subcommand parameter" (eq (coll.JQ `.subcommand | length` $report) 0) -}}
  {{- test.Assert "every individually declared MCP tool must appear on a tool node" (eq (coll.JQ `.missing | length` $report) 0) -}}
{{- end -}}
{{- $dsl = dict "dsl" $dsl "prompt" $prompt | coll.JQ `.prompt as $prompt | .dsl | walk(if type == "string" then split("__DIFY_SYSTEM_PROMPT__") | join($prompt) else . end)` -}}
